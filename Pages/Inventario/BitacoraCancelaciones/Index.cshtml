@page
@model DiamondsWeb.Pages.Inventario.BitacoraCancelaciones.IndexModel
@{
    ViewData["Title"] = "Bitacora de Cancelaciones";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-ban me-2"></i>Bitacora de Cancelaciones</span>
        <a asp-page="/Inventario/PiezasSencillas/Index" class="btn btn-light btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Volver a Piezas
        </a>
    </div>
    <div class="card-body">
        <!-- Filtros -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="buscar"
                       value="@Model.Buscar" placeholder="Codigo o descripcion..." />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Desde</small></label>
                <input type="date" class="form-control form-control-sm" name="desde"
                       value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Hasta</small></label>
                <input type="date" class="form-control form-control-sm" name="hasta"
                       value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-danger btn-sm w-100" title="Buscar">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
            <div class="col-md-1">
                <a href="/Inventario/BitacoraCancelaciones" class="btn btn-outline-secondary btn-sm w-100" title="Limpiar">
                    <i class="fa-solid fa-eraser"></i>
                </a>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th class="text-end">Costo Bruto</th>
                        <th class="text-end">Precio</th>
                        <th>Fecha Captura</th>
                        <th>Fecha Borrado</th>
                        <th>Borrado por</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cancelaciones.Any())
                    {
                        @foreach (var c in Model.Cancelaciones)
                        {
                            <tr>
                                <td><code>@c.CodigoBarras</code></td>
                                <td>@c.Descripcion</td>
                                <td class="text-end">@(c.CBTotal?.ToString("C2") ?? "-")</td>
                                <td class="text-end fw-semibold">@(c.Precio?.ToString("C0") ?? "-")</td>
                                <td>
                                    @if (c.FechaCaptura.HasValue)
                                    {
                                        <span class="utc-date" data-utc="@c.FechaCaptura.Value.ToString("o")Z">
                                            @c.FechaCaptura.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (c.FechaBorrado.HasValue)
                                    {
                                        <span class="utc-date" data-utc="@c.FechaBorrado.Value.ToString("o")Z">
                                            @c.FechaBorrado.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@(c.NombreUsuarioBorrado ?? $"User #{c.IdUsuarioBorrado}")</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron cancelaciones.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            <small><i class="fa-solid fa-circle-info me-1"></i>Se muestran hasta 50 registros. Use los filtros para refinar la busqueda.</small>
        </div>
    </div>
</div>
