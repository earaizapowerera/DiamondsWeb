@page
@model DiamondsWeb.Pages.Inventario.PiezasCompuestas.IndexModel
@{
    ViewData["Title"] = "Piezas Compuestas";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Listado -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-puzzle-piece me-2"></i>Piezas Compuestas
    </div>
    <div class="card-body">

        <!-- Filtro -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-8">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Descripcion o codigo de barras..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-2">
                <a href="/Inventario/PiezasCompuestas" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>

        <!-- Tabla de Piezas Compuestas -->
        <div class="table-responsive">
            <table class="table table-hover table-striped table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:40px;"></th>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th>Etiqueta</th>
                        <th class="text-center">Componentes</th>
                        <th class="text-end">Precio Total</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Piezas.Any())
                    {
                        @foreach (var pc in Model.Piezas)
                        {
                            var estaExpandida = Model.Expandir == pc.CodigoBarras;
                            <tr class="@(estaExpandida ? "table-active" : "")">
                                <td>
                                    @if (estaExpandida)
                                    {
                                        <a asp-page="Index" asp-route-Buscar="@Model.Buscar"
                                           class="btn btn-sm btn-outline-primary" title="Colapsar">
                                            <i class="fa-solid fa-chevron-down"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-page="Index" asp-route-Buscar="@Model.Buscar" asp-route-Expandir="@pc.CodigoBarras"
                                           class="btn btn-sm btn-outline-secondary" title="Expandir">
                                            <i class="fa-solid fa-chevron-right"></i>
                                        </a>
                                    }
                                </td>
                                <td><code>@pc.CodigoBarras</code></td>
                                <td>@pc.Descripcion</td>
                                <td>@pc.EtiquetaK</td>
                                <td class="text-center">
                                    <span class="badge bg-info">@(pc.Componentes ?? 0)</span>
                                </td>
                                <td class="text-end fw-semibold">@(pc.PrecioTotal?.ToString("C2") ?? "$0.00")</td>
                                <td>@pc.FechaCaptura?.ToString("dd/MM/yyyy")</td>
                            </tr>

                            @if (estaExpandida && Model.ComponentesPorPieza.ContainsKey(pc.CodigoBarras))
                            {
                                var componentes = Model.ComponentesPorPieza[pc.CodigoBarras];
                                <tr>
                                    <td colspan="7" class="p-0">
                                        <div class="bg-light border-start border-4 border-primary p-3 ms-4">
                                            <h6 class="mb-3">
                                                <i class="fa-solid fa-list-check me-1"></i>
                                                Componentes de <strong>@pc.CodigoBarras</strong>
                                            </h6>

                                            @if (componentes.Any())
                                            {
                                                <table class="table table-sm table-bordered mb-3">
                                                    <thead class="table-secondary">
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Codigo</th>
                                                            <th>Descripcion</th>
                                                            <th>Proveedor</th>
                                                            <th class="text-end">Precio</th>
                                                            <th class="text-center">Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var comp in componentes)
                                                        {
                                                            <tr>
                                                                <td>@comp.Indice</td>
                                                                <td><code>@comp.CodigoBarras</code></td>
                                                                <td>@comp.Descripcion</td>
                                                                <td>@comp.NombreProveedor</td>
                                                                <td class="text-end">@(comp.Precio?.ToString("C2"))</td>
                                                                <td class="text-center">
                                                                    <form method="post" asp-page-handler="RemoverComponente" class="d-inline">
                                                                        <input type="hidden" name="CBPadre" value="@pc.CodigoBarras" />
                                                                        <input type="hidden" name="CBComponente" value="@comp.CodigoBarras" />
                                                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                                                onclick="return confirm('Remover componente @comp.CodigoBarras?')"
                                                                                title="Remover">
                                                                            <i class="fa-solid fa-xmark"></i>
                                                                        </button>
                                                                    </form>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-3">
                                                    <i class="fa-solid fa-info-circle me-1"></i>Esta pieza no tiene componentes aun.
                                                </p>
                                            }

                                            <!-- Agregar Componente -->
                                            <form method="post" asp-page-handler="AgregarComponente" class="row g-2 align-items-end">
                                                <input type="hidden" name="CBPadre" value="@pc.CodigoBarras" />
                                                <div class="col-md-4">
                                                    <label class="form-label"><small>Codigo de Barras del Componente</small></label>
                                                    <input type="text" name="CBComponente" class="form-control form-control-sm"
                                                           placeholder="Escanee o escriba el codigo..." required />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label"><small>Indice</small></label>
                                                    <input type="number" name="IndiceComponente" class="form-control form-control-sm"
                                                           value="@(componentes.Count + 1)" min="1" />
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                                        <i class="fa-solid fa-plus me-1"></i>Agregar Componente
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron piezas compuestas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Crear Nueva Pieza Compuesta -->
<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <i class="fa-solid fa-plus me-2"></i>Crear Nueva Pieza Compuesta
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label"><small>Descripcion</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevaDescripcion"
                       placeholder="Descripcion de la pieza compuesta..." required />
            </div>
            <div class="col-md-2">
                <label class="form-label"><small>Etiqueta K</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevaEtiquetaK"
                       placeholder="Ej: 14K" />
            </div>
            <div class="col-md-4">
                <label class="form-label"><small>Linea 1 (etiqueta)</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevaLinea1"
                       placeholder="Linea 1..." />
            </div>
            <div class="col-md-4">
                <label class="form-label"><small>Linea 2 (etiqueta)</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevaLinea2"
                       placeholder="Linea 2..." />
            </div>
            <div class="col-md-4">
                <label class="form-label"><small>Linea 3 (etiqueta)</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevaLinea3"
                       placeholder="Linea 3..." />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-puzzle-piece me-1"></i>Crear Pieza Compuesta
                </button>
            </div>
        </form>
    </div>
</div>
