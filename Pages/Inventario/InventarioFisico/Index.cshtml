@page
@model DiamondsWeb.Pages.Inventario.InventarioFisico.IndexModel
@{
    ViewData["Title"] = "Inventario Fisico";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Registro -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-clipboard-check me-2"></i>Inventario Fisico
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Registrar" class="row g-3 align-items-end mb-4">
            <div class="col-md-8">
                <label class="form-label"><small>Codigo de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="CodigoBarras"
                       id="inputCodigoBarras" placeholder="Escanear o escribir codigo de barras..." autofocus />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Registrar
                </button>
            </div>
        </form>

        <!-- Toggle Hoy/Todos -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-info fs-6">
                <i class="fa-solid fa-hashtag me-1"></i>Total: @Model.TotalRegistros
            </span>
            <div class="btn-group btn-group-sm">
                <a href="?SoloHoy=true" class="btn @(Model.SoloHoy ? "btn-primary" : "btn-outline-primary")">
                    <i class="fa-solid fa-calendar-day me-1"></i>Hoy
                </a>
                <a href="?SoloHoy=false" class="btn @(!Model.SoloHoy ? "btn-primary" : "btn-outline-primary")">
                    <i class="fa-solid fa-calendar me-1"></i>Todos
                </a>
            </div>
        </div>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo Barras</th>
                        <th>Descripcion</th>
                        <th class="text-end">Precio</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Registros.Any())
                    {
                        @foreach (var r in Model.Registros)
                        {
                            <tr>
                                <td><code>@r.CodigoBarras</code></td>
                                <td>@r.Descripcion</td>
                                <td class="text-end">@(r.Precio?.ToString("C2"))</td>
                                <td>@r.IdUsuario</td>
                                <td>@r.FechaCaptura?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="Eliminar" class="d-inline">
                                        <input type="hidden" name="codigoBarras" value="@r.CodigoBarras" />
                                        <input type="hidden" name="fechaCaptura" value="@r.FechaCaptura?.ToString("o")" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"
                                                onclick="return confirm('Eliminar registro @r.CodigoBarras?')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var input = document.getElementById('inputCodigoBarras');
        if (input) input.focus();
    });
</script>
}
