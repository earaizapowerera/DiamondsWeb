@page
@model DiamondsWeb.Pages.Inventario.PiezasSencillas.IndexModel
@{
    ViewData["Title"] = "Piezas Sencillas";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Filtros -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-ring me-2"></i>Piezas Sencillas</span>
        <div class="d-flex gap-2">
            <div id="columnSelectorContainer"></div>
            <a asp-page="Detalle" class="btn btn-light btn-sm">
                <i class="fa-solid fa-plus me-1"></i>Nueva Pieza
            </a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Descripcion, codigo, modelo, serie..." />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Grupo</small></label>
                <select name="IdGrupo" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" selected="@(Model.IdGrupo == g.IdGrupo)">@g.Grupo1</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Proveedor</small></label>
                <select name="Proveedor" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    @foreach (var p in Model.Proveedores)
                    {
                        <option value="@p.Proveedor1" selected="@(Model.Proveedor == p.Proveedor1)">@p.NombreProveedor</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100" title="Buscar">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
            <div class="col-md-1">
                <a href="/Inventario/PiezasSencillas" class="btn btn-outline-secondary btn-sm w-100" title="Limpiar">
                    <i class="fa-solid fa-eraser"></i>
                </a>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped table-sm mb-0" id="piezasSencillasTable">
                <thead class="table-dark">
                    <tr>
                        <th data-col="CodigoBarras">Codigo</th>
                        <th data-col="Descripcion">Descripcion</th>
                        <th data-col="Grupo">Grupo</th>
                        <th data-col="NombreProveedor">Proveedor</th>
                        <th data-col="Precio" class="text-end">Precio</th>
                        <th data-col="IdStatus" class="text-center">Status</th>
                        <th data-col="FechaCaptura">Fecha</th>
                        <th data-col="Peso" class="text-end" style="display:none">Peso</th>
                        <th data-col="Kilates" style="display:none">Kilates</th>
                        <th data-col="Modelo" style="display:none">Modelo</th>
                        <th data-col="Linea" style="display:none">Linea</th>
                        <th data-col="CBTotal" class="text-end" style="display:none">C. Bruto</th>
                        <th data-col="CNTotal" class="text-end" style="display:none">C. Neto</th>
                        <th data-col="Quilates" class="text-end" style="display:none">Quilates</th>
                        <th data-col="Color" style="display:none">Color</th>
                        <th data-col="NumSerie" style="display:none">No. Serie</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Piezas.Any())
                    {
                        @foreach (var p in Model.Piezas)
                        {
                            <tr>
                                <td data-col="CodigoBarras">
                                    <code>@p.CodigoBarras</code>
                                </td>
                                <td data-col="Descripcion">@p.Descripcion</td>
                                <td data-col="Grupo"><span class="badge bg-secondary">@p.Grupo</span></td>
                                <td data-col="NombreProveedor">@p.NombreProveedor</td>
                                <td data-col="Precio" class="text-end fw-semibold">@(p.Precio?.ToString("C2"))</td>
                                <td data-col="IdStatus" class="text-center">
                                    @if (p.IdStatus == 1)
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@(p.IdStatus)</span>
                                    }
                                </td>
                                <td data-col="FechaCaptura">@p.FechaCaptura?.ToString("dd/MM/yyyy")</td>
                                <td data-col="Peso" class="text-end" style="display:none">@(p.Peso > 0 ? p.Peso?.ToString("N2") : "")</td>
                                <td data-col="Kilates" style="display:none">@p.Kilates</td>
                                <td data-col="Modelo" style="display:none">@p.Modelo</td>
                                <td data-col="Linea" style="display:none">@p.Linea</td>
                                <td data-col="CBTotal" class="text-end" style="display:none">@(p.CBTotal?.ToString("N2"))</td>
                                <td data-col="CNTotal" class="text-end" style="display:none">@(p.CNTotal?.ToString("N2"))</td>
                                <td data-col="Quilates" class="text-end" style="display:none">@(p.Quilates > 0 ? p.Quilates.ToString("N2") : "")</td>
                                <td data-col="Color" style="display:none">@p.Color</td>
                                <td data-col="NumSerie" style="display:none">@p.NumSerie</td>
                                <td class="text-center">
                                    <a asp-page="Detalle" asp-route-codigoBarras="@p.CodigoBarras"
                                       class="btn btn-outline-primary btn-sm" title="Ver / Editar">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="17" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron piezas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            <small><i class="fa-solid fa-circle-info me-1"></i>Se muestran hasta 200 resultados. Use los filtros para refinar la busqueda.</small>
        </div>
    </div>
</div>

@section Scripts {
<script src="/js/column-config.js?v=20260615"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Inicializar columnas configurables
    initColumnConfig('vPiezasSencillasWeb', '#piezasSencillasTable');
});
</script>
}
