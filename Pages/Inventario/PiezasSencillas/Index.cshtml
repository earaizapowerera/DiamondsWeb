@page
@model DiamondsWeb.Pages.Inventario.PiezasSencillas.IndexModel
@{
    ViewData["Title"] = "Piezas Sencillas";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Filtros -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-ring me-2"></i>Piezas Sencillas</span>
        <div>
            <a asp-page="/Inventario/BitacoraCancelaciones/Index" class="btn btn-outline-light btn-sm me-1">
                <i class="fa-solid fa-ban me-1"></i>Bitacora
            </a>
            <a asp-page="Detalle" class="btn btn-light btn-sm">
                <i class="fa-solid fa-plus me-1"></i>Nueva Pieza
            </a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Descripcion, codigo, modelo, serie..." />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Grupo</small></label>
                <select name="IdGrupo" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" selected="@(Model.IdGrupo == g.IdGrupo)">@g.Grupo1</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Proveedor</small></label>
                <select name="Proveedor" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    @foreach (var p in Model.Proveedores)
                    {
                        <option value="@p.Proveedor1" selected="@(Model.Proveedor == p.Proveedor1)">@p.NombreProveedor</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100" title="Buscar">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
            <div class="col-md-1">
                <a href="/Inventario/PiezasSencillas" class="btn btn-outline-secondary btn-sm w-100" title="Limpiar">
                    <i class="fa-solid fa-eraser"></i>
                </a>
            </div>
        </form>

        <!-- Selector de columnas -->
        <div class="mb-2 d-flex justify-content-end">
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    <i class="fa-solid fa-columns me-1"></i>Columnas
                </button>
                <ul class="dropdown-menu dropdown-menu-end" id="colSelector">
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-codigo" checked> Codigo</label></li>
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-desc" checked> Descripcion</label></li>
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-grupo" checked> Grupo</label></li>
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-prov" checked> Proveedor</label></li>
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-precio" checked> Precio</label></li>
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-status" checked> Status</label></li>
                    <li><label class="dropdown-item"><input type="checkbox" class="col-toggle me-2" data-col="col-fecha" checked> Fecha</label></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-primary" href="#" id="colShowAll">Mostrar todas</a></li>
                </ul>
            </div>
        </div>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped table-sm mb-0" id="tblPiezas">
                <thead class="table-dark">
                    <tr>
                        <th class="col-codigo">Codigo</th>
                        <th class="col-desc">Descripcion</th>
                        <th class="col-grupo">Grupo</th>
                        <th class="col-prov">Proveedor</th>
                        <th class="col-precio text-end">Precio</th>
                        <th class="col-status text-center">Status</th>
                        <th class="col-fecha">Fecha</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Piezas.Any())
                    {
                        @foreach (var p in Model.Piezas)
                        {
                            <tr>
                                <td class="col-codigo">
                                    <code>@p.CodigoBarras</code>
                                </td>
                                <td class="col-desc">@p.Descripcion</td>
                                <td class="col-grupo"><span class="badge bg-secondary">@p.Grupo</span></td>
                                <td class="col-prov">@p.NombreProveedor</td>
                                <td class="col-precio text-end fw-semibold">@(p.Precio?.ToString("C2"))</td>
                                <td class="col-status text-center">
                                    @if (p.IdStatus == 1)
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@(p.IdStatus)</span>
                                    }
                                </td>
                                <td class="col-fecha">@p.FechaCaptura?.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="Detalle" asp-route-codigoBarras="@p.CodigoBarras"
                                           class="btn btn-outline-primary" title="Ver / Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger"
                                                title="Eliminar pieza"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminar"
                                                data-codigo="@p.CodigoBarras"
                                                data-descripcion="@p.Descripcion">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron piezas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-muted">
            <small><i class="fa-solid fa-circle-info me-1"></i>Se muestran hasta 200 resultados. Use los filtros para refinar la busqueda.</small>
        </div>
    </div>
</div>

<!-- Modal de confirmacion de eliminacion -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="fa-solid fa-exclamation-triangle me-2"></i>Confirmar Eliminacion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" asp-page-handler="Delete">
                <div class="modal-body">
                    <p>Esta a punto de eliminar la pieza:</p>
                    <div class="alert alert-warning">
                        <strong>Codigo:</strong> <span id="eliminar-codigo"></span><br />
                        <strong>Descripcion:</strong> <span id="eliminar-descripcion"></span>
                    </div>
                    <p class="text-muted small mb-0">
                        <i class="fa-solid fa-info-circle me-1"></i>
                        La pieza sera movida a la bitacora de cancelaciones. Esta accion no se puede deshacer.
                    </p>
                    <input type="hidden" name="codigoBarras" id="eliminar-codigoBarras" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-1"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Pasar datos de la pieza al modal de eliminacion
    var modalEliminar = document.getElementById('modalEliminar');
    if (modalEliminar) {
        modalEliminar.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var codigo = button.getAttribute('data-codigo');
            var descripcion = button.getAttribute('data-descripcion');

            document.getElementById('eliminar-codigo').textContent = codigo;
            document.getElementById('eliminar-descripcion').textContent = descripcion;
            document.getElementById('eliminar-codigoBarras').value = codigo;
        });
    }

    // Columnas configurables (Ver Columnas)
    (function() {
        var STORAGE_KEY = 'diamonds_cols_piezas';

        function loadPrefs() {
            try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
        }

        function savePrefs(prefs) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
        }

        function applyVisibility(colClass, visible) {
            document.querySelectorAll('.' + colClass).forEach(function(el) {
                el.style.display = visible ? '' : 'none';
            });
        }

        var prefs = loadPrefs();
        document.querySelectorAll('.col-toggle').forEach(function(cb) {
            var col = cb.dataset.col;
            if (prefs[col] === false) {
                cb.checked = false;
                applyVisibility(col, false);
            }
            cb.addEventListener('change', function() {
                var p = loadPrefs();
                p[this.dataset.col] = this.checked;
                savePrefs(p);
                applyVisibility(this.dataset.col, this.checked);
            });
        });

        var showAllBtn = document.getElementById('colShowAll');
        if (showAllBtn) {
            showAllBtn.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelectorAll('.col-toggle').forEach(function(cb) {
                    cb.checked = true;
                    applyVisibility(cb.dataset.col, true);
                });
                savePrefs({});
            });
        }
    })();
</script>
}
