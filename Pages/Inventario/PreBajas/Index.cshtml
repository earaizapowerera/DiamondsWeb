@page
@model DiamondsWeb.Pages.Inventario.PreBajas.IndexModel
@{
    ViewData["Title"] = "Pre Bajas";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Registro de Pre-Baja (escaneo de código de barras) -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-barcode me-2"></i>Registrar Pre-Baja
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end" id="formAgregar">
            <!-- Tipo de Salida -->
            <div class="col-md-4">
                <label class="form-label"><small>Tipo de Salida</small></label>
                <div class="d-flex gap-3 mt-1">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoBaja" id="tipoVenta"
                               value="1" checked />
                        <label class="form-check-label" for="tipoVenta">
                            <i class="fa-solid fa-cart-shopping me-1 text-success"></i>Venta
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="TipoBaja" id="tipoDevolucion"
                               value="2" />
                        <label class="form-check-label" for="tipoDevolucion">
                            <i class="fa-solid fa-rotate-left me-1 text-warning"></i>Devolución
                        </label>
                    </div>
                </div>
            </div>
            <!-- Código de Barras -->
            <div class="col-md-5">
                <label class="form-label"><small>Código de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevoCodigoBarras"
                       id="inputCodigoBarras" required minlength="6" maxlength="8"
                       pattern="[0-9]{6,8}" title="Mínimo 6 dígitos numéricos"
                       placeholder="Escanear o teclear código..." autofocus />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Agregar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Búsqueda y Grid -->
<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <i class="fa-solid fa-list me-2"></i>Pre-Bajas del Día
    </div>
    <div class="card-body">
        <!-- Filtro de búsqueda -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-5">
                <label class="form-label"><small>Buscar por Código</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Código de barras..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-2">
                <a href="/Inventario/PreBajas" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
            <div class="col-md-2">
                <span class="badge bg-info">
                    <i class="fa-solid fa-hashtag me-1"></i>@Model.Items.Count registros
                </span>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código de Barras</th>
                        <th>Descripción</th>
                        <th>Tipo</th>
                        <th>Fecha Captura</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><code>@item.CodigoBarras</code></td>
                                <td>@(item.Descripcion ?? "<sin descripción>")</td>
                                <td>
                                    @if (item.IdTipoBaja == 1)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa-solid fa-cart-shopping me-1"></i>Venta
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa-solid fa-rotate-left me-1"></i>Devolución
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="utc-date" data-utc="@item.FechaCaptura?.ToString("o")">
                                        @item.FechaCaptura?.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="codigoBarras" value="@item.CodigoBarras" />
                                        <input type="hidden" name="fechaCaptura" value="@item.FechaCaptura?.ToString("o")" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"
                                                onclick="return confirm('Eliminar pre-baja @item.CodigoBarras?')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                @if (!string.IsNullOrWhiteSpace(Model.Buscar))
                                {
                                    <span>No se encontraron pre-bajas con código "@Model.Buscar".</span>
                                }
                                else
                                {
                                    <span>No hay pre-bajas registradas hoy.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Auto-submit al escanear código de barras (los scanners envían Enter al final)
    document.getElementById('inputCodigoBarras').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            var val = this.value.trim();
            if (val.length >= 6 && /^\d+$/.test(val)) {
                document.getElementById('formAgregar').submit();
            }
        }
    });

    // Re-focus en el campo de código después de cargar la página
    document.addEventListener('DOMContentLoaded', function () {
        var input = document.getElementById('inputCodigoBarras');
        if (input) input.focus();
    });
</script>
}
