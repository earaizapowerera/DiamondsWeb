@page
@model DiamondsWeb.Pages.Inventario.Transferencias.IndexModel
@{
    ViewData["Title"] = "Transferencias";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Enviar Pieza -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-exchange-alt me-2"></i>Transferencias
    </div>
    <div class="card-body">

        <!-- Seccion: Enviar -->
        <h6><i class="fa-solid fa-paper-plane me-2"></i>Enviar Pieza</h6>
        <form method="post" asp-page-handler="Enviar" class="row g-3 align-items-end mb-4">
            <div class="col-md-5">
                <label class="form-label"><small>Codigo de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="CodigoBarrasEnviar"
                       placeholder="Escanear o escribir codigo de barras..." autofocus />
            </div>
            <div class="col-md-4">
                <label class="form-label"><small>Tienda Destino</small></label>
                <select class="form-select form-select-sm" name="TiendaDestinoEnviar" required>
                    <option value="">-- Seleccionar tienda --</option>
                    @foreach (var t in Model.Tiendas)
                    {
                        <option value="@t.IdTienda">@t.NombreTienda</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-paper-plane me-1"></i>Enviar
                </button>
            </div>
        </form>

        <hr />

        <!-- Seccion: Enviar Repetidas -->
        <h6><i class="fa-solid fa-clone me-2"></i>Enviar Repetidas</h6>
        <form method="post" asp-page-handler="EnviarRepetida" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label"><small>Codigo de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="CodigoBarrasRepetida"
                       placeholder="Codigo de barras..." />
            </div>
            <div class="col-md-2">
                <label class="form-label"><small>Cantidad</small></label>
                <input type="number" class="form-control form-control-sm" name="CantidadRepetida"
                       min="1" value="1" required />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Tienda Destino</small></label>
                <select class="form-select form-select-sm" name="TiendaDestinoRepetida" required>
                    <option value="">-- Seleccionar tienda --</option>
                    @foreach (var t in Model.Tiendas)
                    {
                        <option value="@t.IdTienda">@t.NombreTienda</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-clone me-1"></i>Enviar Repetidas
                </button>
            </div>
        </form>

        <hr />

        <!-- Seccion: Recibir -->
        <h6><i class="fa-solid fa-box-open me-2"></i>Recibir Pieza</h6>
        <form method="post" asp-page-handler="Recibir" class="row g-3 align-items-end mb-4">
            <div class="col-md-8">
                <label class="form-label"><small>Codigo de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="CodigoBarrasRecibir"
                       placeholder="Escanear o escribir codigo de barras..." />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-box-open me-1"></i>Recibir
                </button>
            </div>
        </form>

        <hr />

        <!-- Tabla de Transferencias Recientes -->
        <h6><i class="fa-solid fa-list me-2"></i>Transferencias Recientes</h6>
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo Barras</th>
                        <th>Descripcion</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transferencias.Any())
                    {
                        @foreach (var t in Model.Transferencias)
                        {
                            <tr>
                                <td><code>@t.CodigoBarras</code></td>
                                <td>@t.Descripcion</td>
                                <td>@t.NombreTiendaOrigen</td>
                                <td>@t.NombreTiendaDestino</td>
                                <td>@t.IdUsuario</td>
                                <td>@t.FechaTransferencia?.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron transferencias.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
