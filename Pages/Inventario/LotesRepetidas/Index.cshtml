@page
@model DiamondsWeb.Pages.Inventario.LotesRepetidas.IndexModel
@{
    ViewData["Title"] = "Lotes de Repetidas";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Listado de Lotes -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-boxes-packing me-2"></i>Lotes de Repetidas
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lote</th>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">C. Bruto</th>
                        <th class="text-end">C. Neto</th>
                        <th class="text-end">Utilidad</th>
                        <th class="text-end">U. Extra</th>
                        <th class="text-end">Impuesto</th>
                        <th class="text-end">Divisor</th>
                        <th class="text-end">Precio</th>
                        <th>Proveedor</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lotes.Any())
                    {
                        @foreach (var lote in Model.Lotes)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@lote.IdLote</span></td>
                                <td><code>@lote.CodigoBarras</code></td>
                                <td>@lote.Descripcion</td>
                                <td class="text-center">
                                    <span class="badge bg-info">@lote.Cantidad</span>
                                </td>
                                <td class="text-end">@(lote.CostoBruto?.ToString("N2"))</td>
                                <td class="text-end">@(lote.CostoNeto?.ToString("N2"))</td>
                                <td class="text-end">@(lote.Utilidad?.ToString("N2"))%</td>
                                <td class="text-end">@(lote.UtilidadExtra?.ToString("N2"))%</td>
                                <td class="text-end">@(lote.Impuesto?.ToString("N2"))%</td>
                                <td class="text-end">@(lote.Divisor?.ToString("N4"))</td>
                                <td class="text-end fw-semibold">@(lote.Precio?.ToString("C2"))</td>
                                <td>@lote.NombreProveedor</td>
                                <td>@lote.FechaCaptura?.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron lotes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Crear Nuevo Lote -->
<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <i class="fa-solid fa-plus me-2"></i>Crear Nuevo Lote
    </div>
    <div class="card-body">
        <form method="post" id="formNuevoLote">
            <div class="row g-3">
                <!-- Pieza del catalogo -->
                <div class="col-md-6">
                    <label class="form-label"><small>Pieza del Catalogo de Repetidas</small></label>
                    <select class="form-select form-select-sm" name="NuevoCodigoBarras" required>
                        <option value="">-- Seleccione una pieza --</option>
                        @foreach (var cr in Model.CatalogoRepetidas)
                        {
                            <option value="@cr.CodigoBarras">
                                @cr.CodigoBarras - @cr.Descripcion (@cr.NombreProveedor)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><small>Cantidad</small></label>
                    <input type="number" class="form-control form-control-sm" name="NuevaCantidad"
                           value="1" min="1" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label"><small>Moneda</small></label>
                    <select class="form-select form-select-sm" name="NuevoIdMoneda">
                        <option value="">-- Seleccione --</option>
                        @foreach (var m in Model.Monedas)
                        {
                            <option value="@m.IdMoneda">@m.Moneda1</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Costos -->
            <div class="card bg-light border mt-3">
                <div class="card-header py-2">
                    <small class="fw-semibold"><i class="fa-solid fa-calculator me-1"></i>Costos y Precios</small>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label"><small>Costo Bruto</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   name="NuevoCostoBruto" id="costoBruto" value="0" placeholder="0.00"
                                   oninput="calcularCostoNeto()" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><small>Descuento %</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   name="NuevoDescuento" id="descuento" value="0" placeholder="0.00"
                                   oninput="calcularCostoNeto()" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><small>Costo Neto</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm border-primary fw-semibold"
                                   name="NuevoCostoNeto" id="costoNeto" value="0" placeholder="0.00" readonly />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="p-2 bg-white rounded border w-100 text-center">
                                <small class="text-muted">Neto = Bruto * (1 - Desc%/100)</small>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label"><small>Utilidad %</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   name="NuevaUtilidad" value="0" placeholder="0.00" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label"><small>Utilidad Extra %</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   name="NuevaUtilidadExtra" value="0" placeholder="0.00" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label"><small>Impuesto %</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   name="NuevoImpuesto" value="0" placeholder="0.00" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label"><small>Divisor</small></label>
                            <input type="number" step="0.0001" class="form-control form-control-sm"
                                   name="NuevoDivisor" value="1" placeholder="1.0000" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label"><small>TC Costo</small></label>
                            <input type="number" step="0.0001" class="form-control form-control-sm"
                                   name="NuevoTCCosto" value="1" placeholder="1.0000" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label"><small>TC Cotizacion</small></label>
                            <input type="number" step="0.0001" class="form-control form-control-sm"
                                   name="NuevoTCCotizacion" value="1" placeholder="1.0000" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-boxes-packing me-1"></i>Crear Lote
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function calcularCostoNeto() {
        var bruto = parseFloat(document.getElementById('costoBruto').value) || 0;
        var desc = parseFloat(document.getElementById('descuento').value) || 0;
        var neto = bruto * (1 - desc / 100);
        document.getElementById('costoNeto').value = neto.toFixed(2);
    }
</script>
}
