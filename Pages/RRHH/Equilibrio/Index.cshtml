@page
@model DiamondsWeb.Pages.RRHH.Equilibrio.IndexModel
@{
    ViewData["Title"] = "Equilibrio de Comisiones";
}

<!-- Alertas -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h4 class="mb-3"><i class="fa-solid fa-scale-balanced me-2"></i>Equilibrio de Comisiones</h4>

<!-- Filtros -->
<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label form-label-sm mb-0">Tienda</label>
        <select name="IdTienda" class="form-select form-select-sm" id="selectTienda">
            @foreach (var t in Model.Tiendas)
            {
                <option value="@t.IdTienda" selected="@(t.IdTienda == Model.IdTienda)">@t.NombreTienda</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label form-label-sm mb-0">Mes</label>
        <select name="Mes" class="form-select form-select-sm">
            @{
                var meses = new[] { "Enero","Febrero","Marzo","Abril","Mayo","Junio",
                                    "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre" };
            }
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" selected="@(i == Model.Mes)">@meses[i - 1]</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label form-label-sm mb-0">A&ntilde;o</label>
        <select name="Anio" class="form-select form-select-sm">
            @for (int y = DateTime.UtcNow.Year; y >= 2000; y--)
            {
                <option value="@y" selected="@(y == Model.Anio)">@y</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-calculator me-1"></i> Calcular
        </button>
    </div>
</form>

<!-- Resultado -->
@if (Model.BusquedaRealizada && Model.Resultado != null)
{
    var r = Model.Resultado;
    var balanceColor = r.EsPositivo ? "success" : "danger";
    var balanceIcon = r.EsPositivo ? "fa-arrow-up" : "fa-arrow-down";

    <div class="row g-3">
        <!-- Ventas Comisionables -->
        <div class="col-md-4">
            <div class="card border-start border-primary border-3 h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">
                        <i class="fa-solid fa-cart-shopping me-1"></i>Ventas Comisionables
                    </div>
                    <div class="fs-4 fw-bold text-primary">
                        @r.VentasComisionables.ToString("C0")
                    </div>
                    <div class="text-muted small mt-1">
                        Grupo 12 &gt; $6,000 &middot; Prov 90 &gt; $12,000
                    </div>
                </div>
            </div>
        </div>

        <!-- Comisiones Pagadas -->
        <div class="col-md-4">
            <div class="card border-start border-warning border-3 h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">
                        <i class="fa-solid fa-money-bill-wave me-1"></i>Comisiones Pagadas
                    </div>
                    <div class="fs-4 fw-bold text-warning">
                        @r.ComisionesPagadas.ToString("C0")
                    </div>
                    <div class="text-muted small mt-1">
                        Registros en tabla MR
                    </div>
                </div>
            </div>
        </div>

        <!-- Balance -->
        <div class="col-md-4">
            <div class="card border-start border-@balanceColor border-3 h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">
                        <i class="fa-solid fa-scale-balanced me-1"></i>Balance
                    </div>
                    <div class="fs-3 fw-bold text-@balanceColor">
                        <i class="fa-solid @balanceIcon me-1"></i>
                        @r.Balance.ToString("C0")
                    </div>
                    <div class="text-muted small mt-1">
                        @(r.EsPositivo ? "Ventas superan comisiones" : "Comisiones superan ventas")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra visual del balance -->
    <div class="mt-4">
        <div class="d-flex justify-content-between small text-muted mb-1">
            <span>Comisiones Pagadas</span>
            <span>Ventas Comisionables</span>
        </div>
        @{
            var total = r.VentasComisionables + r.ComisionesPagadas;
            var pctVentas = total > 0 ? (int)(r.VentasComisionables / total * 100) : 50;
            var pctComisiones = 100 - pctVentas;
        }
        <div class="progress" style="height: 28px;">
            <div class="progress-bar bg-warning" role="progressbar"
                 style="width: @(pctComisiones)%"
                 title="Comisiones: @r.ComisionesPagadas.ToString("C0")">
                @r.ComisionesPagadas.ToString("C0")
            </div>
            <div class="progress-bar bg-@balanceColor" role="progressbar"
                 style="width: @(pctVentas)%"
                 title="Ventas: @r.VentasComisionables.ToString("C0")">
                @r.VentasComisionables.ToString("C0")
            </div>
        </div>
    </div>
}
else if (Model.BusquedaRealizada)
{
    <div class="text-center text-muted py-5">
        <i class="fa-solid fa-inbox fa-2x mb-2"></i>
        <p>No se encontraron datos para el per&iacute;odo seleccionado.</p>
    </div>
}
