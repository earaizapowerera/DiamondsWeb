@page
@model DiamondsWeb.Pages.Ventas.Consignacion.IndexModel
@{
    ViewData["Title"] = "Cuentas de Consignacion";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
<div class="alert alert-danger">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@Model.ErrorMessage
</div>
}

<!-- Dashboard Stats -->
<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="stat-card bg-primary-custom">
            <div class="stat-number">@Model.Stats.TotalRemisiones</div>
            <div class="stat-label"><i class="fa-solid fa-file-invoice me-1"></i>Remisiones</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="stat-card bg-success-custom">
            <div class="stat-number">@Model.Stats.PiezasEnExistencia</div>
            <div class="stat-label"><i class="fa-solid fa-gem me-1"></i>En Existencia</div>
            <div class="stat-sublabel">@Model.Stats.MontoEnExistencia.ToString("C2")</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="stat-card bg-warning-custom">
            <div class="stat-number">@Model.Stats.PiezasPorDevolver</div>
            <div class="stat-label"><i class="fa-solid fa-clock-rotate-left me-1"></i>Por Devolver</div>
            <div class="stat-sublabel">@Model.Stats.MontoPorDevolver.ToString("C2")</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="stat-card bg-secondary">
            <div class="stat-number">@Model.Stats.PiezasDevueltas</div>
            <div class="stat-label"><i class="fa-solid fa-check-circle me-1"></i>Devueltas</div>
            <div class="stat-sublabel">@Model.Stats.MontoDevueltas.ToString("C2")</div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="filter-panel">
    <form method="get" id="filterForm">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label"><small>Remision</small></label>
                <select class="form-select form-select-sm" name="idRemision" id="selectRemision">
                    <option value="">-- Todas las remisiones --</option>
                    @foreach (var rem in Model.Remisiones)
                    {
                        if (Model.IdRemision == rem.IdRemision)
                        {
                            <option value="@rem.IdRemision" selected>
                                @rem.Remision - @rem.NombreProveedor (@rem.FechaRemision.ToString("dd/MM/yyyy")) — @rem.TotalPiezas pzas
                            </option>
                        }
                        else
                        {
                            <option value="@rem.IdRemision">
                                @rem.Remision - @rem.NombreProveedor (@rem.FechaRemision.ToString("dd/MM/yyyy")) — @rem.TotalPiezas pzas
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Cuentas desde</small></label>
                <input type="date" class="form-control form-control-sm" name="fechaDesde"
                       value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Filtrar
                </button>
            </div>
            <div class="col-md-2">
                <a href="/Ventas/Consignacion" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var sel = document.querySelector('#selectRemision');
    if (sel && typeof TomSelect !== 'undefined') {
        new TomSelect(sel, {
            allowEmptyOption: true,
            sortField: { field: 'text', direction: 'asc' },
            onChange: function() { sel.form.submit(); }
        });
    }
});
</script>
}

<!-- Grid: En Existencia -->
<div class="card mb-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-gem me-2"></i>En Existencia (@Model.EnExistencia.Count)</span>
        <span class="badge bg-light text-dark">@Model.EnExistencia.Sum(p => p.CBTotal).ToString("C2")</span>
    </div>
    <div class="card-body p-0">
        @if (Model.EnExistencia.Any())
        {
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0" id="tblEnExistencia">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th>Proveedor</th>
                        <th>Remision</th>
                        <th>Fecha</th>
                        <th class="text-end">Peso</th>
                        <th class="text-end">Precio</th>
                        <th>Kilates</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.EnExistencia.Count; i++)
                    {
                        var p = Model.EnExistencia[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><code>@p.CodigoBarras</code></td>
                            <td>@p.Descripcion</td>
                            <td>@p.NombreProveedor</td>
                            <td>@p.Remision</td>
                            <td>@p.FechaRemision.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@(p.Peso > 0 ? p.Peso.ToString("N3") : "-")</td>
                            <td class="text-end"><strong>@p.CBTotal.ToString("C2")</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(p.Kilates) ? "-" : p.Kilates)</td>
                            <td><span class="badge bg-success">@p.NombreStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        else
        {
        <div class="text-center text-muted py-4">
            <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
            <small>No hay piezas en existencia con los filtros seleccionados</small>
        </div>
        }
    </div>
</div>

