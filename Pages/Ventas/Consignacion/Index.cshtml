@page
@model DiamondsWeb.Pages.Ventas.Consignacion.IndexModel
@{
    ViewData["Title"] = "Consignacion";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-handshake me-2"></i>Consignacion
    </div>
    <div class="card-body">
        <!-- Filtro -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label"><small>Filtrar por Remision</small></label>
                <input type="text" class="form-control form-control-sm" name="IdRemision"
                       value="@Model.IdRemision" placeholder="ID de remision..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Filtrar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Ventas/Consignacion" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>

        <!-- Resumen -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-success">
                    <div class="card-body text-center py-2">
                        <small class="text-muted">En Existencia</small>
                        <h4 class="mb-0 text-success">@Model.EnExistencia.Count</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-warning">
                    <div class="card-body text-center py-2">
                        <small class="text-muted">Por Devolver</small>
                        <h4 class="mb-0 text-warning">@Model.PorDevolver.Count</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-secondary">
                    <div class="card-body text-center py-2">
                        <small class="text-muted">Devuelto</small>
                        <h4 class="mb-0 text-secondary">@Model.Devuelto.Count</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seccion: En Existencia -->
        <h6 class="mt-3">
            <i class="fa-solid fa-box-open me-2 text-success"></i>En Existencia
            <span class="badge bg-success ms-1">@Model.EnExistencia.Count</span>
        </h6>
        <div class="table-responsive mb-4">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th class="text-end">Precio</th>
                        <th>Proveedor</th>
                        <th>Remision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.EnExistencia.Any())
                    {
                        @foreach (var item in Model.EnExistencia)
                        {
                            <tr>
                                <td>@item.CodigoBarras</td>
                                <td>@item.Descripcion</td>
                                <td class="text-end">@item.Precio?.ToString("C2")</td>
                                <td>@item.NombreProveedor</td>
                                <td>@item.IdRemision</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Sin piezas en existencia.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Seccion: Por Devolver -->
        <h6 class="mt-3">
            <i class="fa-solid fa-clock me-2 text-warning"></i>Por Devolver
            <span class="badge bg-warning text-dark ms-1">@Model.PorDevolver.Count</span>
        </h6>
        <div class="table-responsive mb-4">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th class="text-end">Precio</th>
                        <th>Proveedor</th>
                        <th>Remision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PorDevolver.Any())
                    {
                        @foreach (var item in Model.PorDevolver)
                        {
                            <tr>
                                <td>@item.CodigoBarras</td>
                                <td>@item.Descripcion</td>
                                <td class="text-end">@item.Precio?.ToString("C2")</td>
                                <td>@item.NombreProveedor</td>
                                <td>@item.IdRemision</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Sin piezas por devolver.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Seccion: Devuelto -->
        <h6 class="mt-3">
            <i class="fa-solid fa-check-circle me-2 text-secondary"></i>Devuelto
            <span class="badge bg-secondary ms-1">@Model.Devuelto.Count</span>
        </h6>
        <div class="table-responsive mb-4">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th class="text-end">Precio</th>
                        <th>Proveedor</th>
                        <th>Remision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Devuelto.Any())
                    {
                        @foreach (var item in Model.Devuelto)
                        {
                            <tr>
                                <td>@item.CodigoBarras</td>
                                <td>@item.Descripcion</td>
                                <td class="text-end">@item.Precio?.ToString("C2")</td>
                                <td>@item.NombreProveedor</td>
                                <td>@item.IdRemision</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Sin piezas devueltas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
