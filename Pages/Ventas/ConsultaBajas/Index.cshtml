@page
@model DiamondsWeb.Pages.Ventas.ConsultaBajas.IndexModel
@{
    ViewData["Title"] = "Consulta de Bajas";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Filtros y Resumen -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-arrow-down me-2"></i>Consulta de Bajas (Piezas Vendidas)
    </div>
    <div class="card-body">
        <!-- Resumen -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body text-center py-2">
                        <small class="text-muted">Total Piezas</small>
                        <h4 class="mb-0 text-info">@Model.TotalPiezas</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-success">
                    <div class="card-body text-center py-2">
                        <small class="text-muted">Suma de Precios</small>
                        <h4 class="mb-0 text-success">@Model.SumaPrecio.ToString("C2")</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Busqueda -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Codigo, descripcion o cliente..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Ventas/ConsultaBajas" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th class="text-end">Precio</th>
                        <th>Proveedor</th>
                        <th>Grupo</th>
                        <th>Cliente</th>
                        <th>Fecha Baja</th>
                        <th>Nota</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Bajas.Any())
                    {
                        @foreach (var b in Model.Bajas)
                        {
                            <tr>
                                <td>@b.CodigoBarras</td>
                                <td>@b.Descripcion</td>
                                <td class="text-end">@b.Precio?.ToString("C2")</td>
                                <td>@b.NombreProveedor</td>
                                <td>@b.Grupo</td>
                                <td>@b.NombreCliente</td>
                                <td>@b.FechaBaja?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a href="/Ventas/ConsultaNotas?IdNotaDetalle=@b.IdNota" class="text-decoration-none">
                                        @b.IdNota
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fa-solid fa-arrow-down fa-2x mb-2 d-block"></i>
                                No se encontraron piezas dadas de baja.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
