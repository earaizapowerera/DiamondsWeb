@page
@model DiamondsWeb.Pages.Ventas.PuntoDeVenta.IndexModel
@{
    ViewData["Title"] = "Punto de Venta";
    var tieneSesion = !string.IsNullOrWhiteSpace(Model.IdNota);
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Header / Session -->
<div class="card mb-3 shadow-sm">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span>
            <i class="fa-solid fa-cash-register me-2"></i>Punto de Venta
        </span>
        @if (tieneSesion)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success fs-6 px-3 py-2">
                    <i class="fa-solid fa-receipt me-1"></i>Nota: @Model.IdNota
                </span>
                <a href="/Ventas/PuntoDeVenta" class="btn btn-outline-light btn-sm">
                    <i class="fa-solid fa-plus me-1"></i>Nueva Sesion
                </a>
            </div>
        }
    </div>

    @if (!tieneSesion)
    {
        <div class="card-body text-center py-5">
            <i class="fa-solid fa-cash-register fa-4x text-muted mb-3 d-block"></i>
            <h5 class="text-muted mb-3">No hay una sesion de venta activa</h5>
            <p class="text-muted mb-4">Inicie una nueva sesion para comenzar a registrar una venta.</p>
            <form method="post" asp-page-handler="CrearSesion">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fa-solid fa-play me-2"></i>Iniciar Nueva Sesion de Venta
                </button>
            </form>
        </div>
    }
</div>

@if (tieneSesion)
{
<div class="row g-3">
    <!-- Left Column: Items -->
    <div class="col-lg-8">
        <!-- Barcode Input -->
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <form method="post" asp-page-handler="AgregarPieza" class="row g-2 align-items-end">
                    <input type="hidden" name="IdNota" value="@Model.IdNota" />
                    <input type="hidden" name="DescuentoPorcentaje" value="@Model.DescuentoPorcentaje" />
                    <input type="hidden" name="SobrePrecio" value="@Model.SobrePrecio" />
                    <div class="col">
                        <label class="form-label"><small>Codigo de Barras</small></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-barcode"></i></span>
                            <input type="text" class="form-control" name="CodigoBarrasInput" id="inputCB"
                                   placeholder="Escanee o escriba el codigo de barras..." autofocus />
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-plus me-1"></i>Agregar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Items Grid -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-primary text-white py-2">
                <i class="fa-solid fa-cart-shopping me-2"></i>Piezas en Venta
                <span class="badge bg-light text-dark ms-2">@Model.PiezasVenta.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Codigo</th>
                                <th>Descripcion</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">SubTotal</th>
                                <th class="text-end">Total</th>
                                <th class="text-center" style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PiezasVenta.Any())
                            {
                                @foreach (var pieza in Model.PiezasVenta)
                                {
                                    <tr>
                                        <td><code>@pieza.CodigoBarras</code></td>
                                        <td>@pieza.Descripcion</td>
                                        <td class="text-center">@pieza.Cantidad</td>
                                        <td class="text-end">@pieza.SubTotal.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@pieza.Total.ToString("N2")</td>
                                        <td class="text-center">
                                            <form method="post" asp-page-handler="EliminarPieza" class="d-inline">
                                                <input type="hidden" name="IdNota" value="@Model.IdNota" />
                                                <input type="hidden" name="DescuentoPorcentaje" value="@Model.DescuentoPorcentaje" />
                                                <input type="hidden" name="SobrePrecio" value="@Model.SobrePrecio" />
                                                <input type="hidden" name="EliminarCB" value="@pieza.CodigoBarras" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Eliminar pieza @pieza.CodigoBarras?')">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="fa-solid fa-cart-shopping fa-2x mb-2 d-block opacity-25"></i>
                                        Escanee un codigo de barras para agregar piezas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Payment & Totals -->
    <div class="col-lg-4">
        <!-- Totals Card -->
        <div class="card mb-3 shadow-sm border-dark">
            <div class="card-header bg-dark text-white py-2">
                <i class="fa-solid fa-receipt me-2"></i>Resumen
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>SubTotal:</span>
                    <span class="fw-semibold">@Model.SubTotal.ToString("C2")</span>
                </div>

                <form method="get" id="formTotales">
                    <input type="hidden" name="IdNota" value="@Model.IdNota" />
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">Desc%</span>
                                <input type="number" step="0.01" class="form-control" name="DescuentoPorcentaje"
                                       value="@Model.DescuentoPorcentaje" onchange="this.form.submit()" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">+$</span>
                                <input type="number" step="0.01" class="form-control" name="SobrePrecio"
                                       value="@Model.SobrePrecio" onchange="this.form.submit()" />
                            </div>
                        </div>
                    </div>
                </form>

                <hr class="my-2" />

                <div class="d-flex justify-content-between mb-2 fs-5">
                    <span class="fw-bold">Total:</span>
                    <span class="fw-bold text-primary">@Model.Total.ToString("C2")</span>
                </div>

                <hr class="my-2" />

                <div class="d-flex justify-content-between mb-1">
                    <span>Total Pagado:</span>
                    <span class="fw-semibold text-success">@Model.TotalPagado.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Cambio:</span>
                    <span class="fw-semibold @(Model.Cambio >= 0 ? "text-success" : "text-danger")">
                        @Model.Cambio.ToString("C2")
                    </span>
                </div>
            </div>
        </div>

        <!-- Payment Section -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-success text-white py-2">
                <i class="fa-solid fa-money-bill-wave me-2"></i>Agregar Pago
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="AgregarPago">
                    <input type="hidden" name="IdNota" value="@Model.IdNota" />
                    <input type="hidden" name="DescuentoPorcentaje" value="@Model.DescuentoPorcentaje" />
                    <input type="hidden" name="SobrePrecio" value="@Model.SobrePrecio" />
                    <div class="mb-2">
                        <label class="form-label"><small>Metodo de Pago</small></label>
                        <select class="form-select form-select-sm" name="PagoOpcionId" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var op in Model.OpcionesPago)
                            {
                                <option value="@op.IdOpcionPago">
                                    @op.OpcionPago1 @(op.Moneda != null ? $"({op.Moneda})" : "")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label"><small>Importe</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm"
                               name="PagoImporte" placeholder="0.00" required min="0.01" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label"><small>Importe Original</small></label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   name="PagoImporteOriginal" placeholder="Opcional" />
                        </div>
                        <div class="col-6">
                            <label class="form-label"><small>Tipo de Cambio</small></label>
                            <input type="number" step="0.0001" class="form-control form-control-sm"
                                   name="PagoTipoCambio" placeholder="Opcional" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm w-100">
                        <i class="fa-solid fa-plus me-1"></i>Agregar Pago
                    </button>
                </form>
            </div>
        </div>

        <!-- Payments Grid -->
        @if (Model.PagosVenta.Any())
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-header py-2">
                    <small class="fw-semibold"><i class="fa-solid fa-credit-card me-2"></i>Pagos Registrados</small>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Metodo</th>
                                <th class="text-end">Importe</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model.PagosVenta)
                            {
                                <tr>
                                    <td>
                                        @pago.NombreOpcionPago
                                        @if (pago.TipoCambio.HasValue && pago.TipoCambio != 0)
                                        {
                                            <br /><small class="text-muted">TC: @pago.TipoCambio</small>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">@pago.Importe.ToString("N2")</td>
                                    <td>
                                        <form method="post" asp-page-handler="EliminarPago" class="d-inline">
                                            <input type="hidden" name="IdNota" value="@Model.IdNota" />
                                            <input type="hidden" name="DescuentoPorcentaje" value="@Model.DescuentoPorcentaje" />
                                            <input type="hidden" name="SobrePrecio" value="@Model.SobrePrecio" />
                                            <input type="hidden" name="EliminarPagoOpcionId" value="@pago.IdOpcionPago" />
                                            <input type="hidden" name="EliminarPagoImporte" value="@pago.Importe" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Eliminar este pago?')">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Customer & Close -->
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning py-2">
                <i class="fa-solid fa-file-invoice-dollar me-2"></i>Cerrar Nota
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="CerrarNota">
                    <input type="hidden" name="IdNota" value="@Model.IdNota" />
                    <input type="hidden" name="DescuentoPorcentaje" value="@Model.DescuentoPorcentaje" />
                    <input type="hidden" name="SobrePrecio" value="@Model.SobrePrecio" />
                    <div class="mb-3">
                        <label class="form-label"><small>Nombre del Cliente</small></label>
                        <input type="text" class="form-control form-control-sm" name="NombreCliente"
                               placeholder="Publico en General" />
                    </div>
                    <button type="submit" class="btn btn-warning w-100 fw-semibold"
                            onclick="return confirm('Cerrar nota @Model.IdNota? Esta accion no se puede deshacer.')">
                        <i class="fa-solid fa-lock me-1"></i>Cerrar Nota
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script>
    // Auto-focus barcode input after page load
    document.addEventListener('DOMContentLoaded', function () {
        var input = document.getElementById('inputCB');
        if (input) input.focus();
    });
</script>
}
