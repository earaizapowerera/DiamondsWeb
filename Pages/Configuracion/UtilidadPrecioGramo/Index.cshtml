@page
@model DiamondsWeb.Pages.Configuracion.UtilidadPrecioGramo.IndexModel
@{
    ViewData["Title"] = "Utilidad Extra por Precio/Gramo";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-weight-hanging me-2"></i>Utilidad Extra por Precio/Gramo
    </div>
    <div class="card-body">
        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Desde</th>
                        <th>Hasta</th>
                        <th>Utilidad Extra %</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rangos.Any())
                    {
                        @foreach (var r in Model.Rangos)
                        {
                            <tr>
                                <td>@r.IdUtilidadExtra</td>
                                <td>
                                    <span id="display-desde-@r.IdUtilidadExtra">@r.PrecioGramoDesde.ToString("N2")</span>
                                </td>
                                <td>
                                    <span id="display-hasta-@r.IdUtilidadExtra">@r.PrecioGramoHasta.ToString("N2")</span>
                                </td>
                                <td>
                                    <span id="display-util-@r.IdUtilidadExtra">@r.UtilidadExtra.ToString("N2")</span>
                                </td>
                                <td>@r.IdUsuario</td>
                                <td>@r.FechaCaptura?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-warning" title="Editar"
                                                onclick="startEdit(@r.IdUtilidadExtra)">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            <input type="hidden" name="id" value="@r.IdUtilidadExtra" />
                                            <button type="submit" class="btn btn-outline-danger" title="Eliminar"
                                                    onclick="return confirm('Eliminar rango?')">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <!-- Inline edit row -->
                            <tr class="d-none" id="edit-row-@r.IdUtilidadExtra">
                                <td colspan="7">
                                    <form method="post" asp-page-handler="Edit">
                                        <input type="hidden" name="EditId" value="@r.IdUtilidadExtra" />
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label"><small>Desde</small></label>
                                                <input type="number" class="form-control form-control-sm" name="EditDesde" value="@r.PrecioGramoDesde" step="0.01" required />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label"><small>Hasta</small></label>
                                                <input type="number" class="form-control form-control-sm" name="EditHasta" value="@r.PrecioGramoHasta" step="0.01" required />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label"><small>Utilidad Extra %</small></label>
                                                <input type="number" class="form-control form-control-sm" name="EditUtilidadExtra" value="@r.UtilidadExtra" step="0.01" required />
                                            </div>
                                            <div class="col-md-1">
                                                <button type="submit" class="btn btn-success btn-sm w-100">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </div>
                                            <div class="col-md-1">
                                                <button type="button" class="btn btn-secondary btn-sm w-100" onclick="cancelEdit(@r.IdUtilidadExtra)">
                                                    <i class="fa-solid fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron rangos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Formulario Nuevo -->
        <hr />
        <h6><i class="fa-solid fa-plus me-2"></i>Agregar Rango</h6>
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label"><small>Desde</small></label>
                <input type="number" class="form-control form-control-sm" name="NuevoDesde" step="0.01" required
                       placeholder="Precio gramo desde..." />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Hasta</small></label>
                <input type="number" class="form-control form-control-sm" name="NuevoHasta" step="0.01" required
                       placeholder="Precio gramo hasta..." />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Utilidad Extra %</small></label>
                <input type="number" class="form-control form-control-sm" name="NuevoUtilidadExtra" step="0.01" required
                       placeholder="% utilidad extra..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Crear Rango
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function startEdit(id) {
        document.getElementById('edit-row-' + id).classList.remove('d-none');
    }
    function cancelEdit(id) {
        document.getElementById('edit-row-' + id).classList.add('d-none');
    }
</script>
}
