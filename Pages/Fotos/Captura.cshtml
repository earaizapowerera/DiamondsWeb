@page
@model DiamondsWeb.Pages.Fotos.CapturaModel
@{
    ViewData["Title"] = "Captura de Fotos";
}

<link rel="stylesheet" href="/css/fotos-pwa.css" asp-append-version="true" />

<div class="fotos-container">

    <!-- Offline banner -->
    <div id="offline-banner" class="offline-banner">
        <i class="fa fa-wifi"></i> Sin conexion - Las fotos se subiran cuando vuelvas a estar en linea
    </div>

    <!-- Install banner (Android/desktop) -->
    <div id="install-banner" class="install-banner">
        <div style="flex:1">
            <strong>Instalar Diamonds Fotos</strong><br>
            <small>Acceso rapido desde tu pantalla de inicio</small>
        </div>
        <button id="btn-install" class="btn-install">Instalar</button>
        <button id="btn-dismiss" class="btn-dismiss">&times;</button>
    </div>

    <!-- iOS install instructions -->
    <div id="ios-instructions" class="ios-instructions">
        <i class="fa fa-info-circle"></i>
        Para instalar esta app en tu iPhone: toca el boton
        <strong>Compartir</strong> <i class="fa fa-share-square-o"></i> y luego
        <strong>"Agregar a inicio"</strong>.
    </div>

    <h4 class="mb-3">
        <i class="fa fa-camera"></i> Captura de Fotos
    </h4>

    <!-- Camera button -->
    <button type="button" id="btn-camera" class="btn-camera">
        <i class="fa fa-camera"></i>
        Tomar Foto o Seleccionar de Galeria
    </button>
    <input type="file"
           id="camera-input"
           class="camera-input"
           accept="image/*"
           capture="environment"
           multiple />

    <!-- Upload progress -->
    <div id="upload-progress" class="upload-progress">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 mb-0">Subiendo foto...</p>
    </div>

    <!-- Recent photos header -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h5 class="mb-0">
            <i class="fa fa-images"></i> Fotos recientes
            <span class="badge bg-secondary" id="foto-count">@Model.FotosRecientes.Count</span>
        </h5>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.initFotosPwa && window.initFotosPwa()">
            <i class="fa fa-refresh"></i>
        </button>
    </div>

    <p class="text-muted small">
        Las fotos aparecen automaticamente en la pantalla web de <strong>Alta de Piezas</strong> para vincularlas.
    </p>

    <!-- Photo grid -->
    <div id="fotos-grid" class="fotos-grid">
        @if (Model.FotosRecientes.Count == 0)
        {
            <!-- Will be replaced by JS -->
        }
        else
        {
            @foreach (var foto in Model.FotosRecientes)
            {
                <div class="foto-card">
                    <img src="@foto.Url" alt="@foto.FileName" loading="lazy" />
                    <div class="foto-info">
                        <span class="badge badge-source bg-@(foto.Source == "mobile" ? "primary" : "secondary")">@foto.Source</span>
                        @foto.UploadedAt.ToString("yyyy-MM-dd HH:mm")
                    </div>
                    <button class="btn-delete" data-id="@foto.Id" title="Eliminar">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            }
        }
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="empty-state" style="display: @(Model.FotosRecientes.Count == 0 ? "block" : "none")">
        <i class="fa fa-camera"></i>
        <p>No hay fotos recientes.<br>Toma una foto para comenzar.</p>
    </div>

</div>

@section Scripts {
    <script src="/js/fotos-pwa.js" asp-append-version="true"></script>
}
