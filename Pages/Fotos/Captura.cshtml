@page
@model DiamondsWeb.Pages.Fotos.CapturaModel
@{
    Layout = null; // Layout propio para PWA movil (sin sidebar de UserPortal)
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#6f42c1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Diamonds Fotos" />
    <title>Diamonds - Fotos de Piezas</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/fotos-pwa.css" />
</head>
<body>

<!-- Offline banner -->
<div id="offline-banner" class="offline-banner">
    <i class="fa fa-wifi me-1"></i> Sin conexion — las fotos se subiran cuando vuelvas a estar en linea
</div>

<!-- Header -->
<nav class="pwa-header">
    <div class="d-flex align-items-center justify-content-between px-3 py-2">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-gem"></i>
            <span class="fw-bold">Diamonds Fotos</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <small class="text-light opacity-75">@Model.NombreUsuario</small>
            <a href="/Security/Auth/Logout" class="btn btn-sm btn-outline-light py-0 px-2">
                <i class="fa fa-sign-out-alt"></i>
            </a>
        </div>
    </div>
</nav>

<div class="fotos-container">

    <!-- Install PWA banner -->
    <div id="install-banner" class="install-banner">
        <div class="flex-grow-1">
            <strong>Instalar App</strong><br/>
            <small>Agrega Diamonds Fotos a tu pantalla de inicio</small>
        </div>
        <button id="btn-install" class="btn-install">Instalar</button>
        <button id="btn-dismiss" class="btn-dismiss">&times;</button>
    </div>

    <!-- iOS install instructions -->
    <div id="ios-instructions" class="ios-instructions">
        <i class="fa fa-arrow-up-from-bracket me-1"></i>
        Para instalar: toca <strong>Compartir</strong> y luego <strong>Agregar a inicio</strong>
    </div>

    <!-- Camera Section -->
    <div class="camera-section mt-3">
        <!-- Live Camera View -->
        <div id="camera-live" class="camera-live d-none">
            <video id="video-preview" autoplay playsinline muted></video>
            <div class="camera-overlay">
                <div class="camera-guide"></div>
            </div>
            <div class="camera-controls">
                <button type="button" id="btn-switch" class="btn-ctrl" title="Cambiar camara">
                    <i class="fa-solid fa-camera-rotate"></i>
                </button>
                <button type="button" id="btn-snap" class="btn-snap" title="Tomar foto">
                    <i class="fa-solid fa-circle"></i>
                </button>
                <button type="button" id="btn-close-cam" class="btn-ctrl" title="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <canvas id="capture-canvas" class="d-none"></canvas>
        </div>

        <!-- Camera button + file input -->
        <div id="camera-start">
            <button type="button" id="btn-camera" class="btn-camera">
                <i class="fa-solid fa-camera"></i>
                Tomar Foto de Pieza
            </button>
            <input type="file" id="camera-input" class="camera-input"
                   accept="image/*" multiple />
            <div class="text-center mt-2">
                <button type="button" id="btn-gallery" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-images me-1"></i>Seleccionar de galeria
                </button>
            </div>
        </div>
    </div>

    <!-- Upload progress -->
    <div id="upload-progress" class="upload-progress">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2">Subiendo foto...</div>
    </div>

    <!-- Recent photos -->
    <div class="mt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                Fotos Recientes
                <span id="foto-count" class="badge bg-secondary ms-1">0</span>
            </h6>
            <button type="button" id="btn-refresh" class="btn btn-sm btn-outline-secondary py-0">
                <i class="fa-solid fa-rotate"></i>
            </button>
        </div>

        <div id="fotos-grid" class="fotos-grid"></div>

        <div id="empty-state" class="empty-state" style="display:none;">
            <i class="fa-solid fa-camera-retro d-block"></i>
            <p class="mb-0">No hay fotos recientes</p>
            <small>Toma tu primera foto para comenzar</small>
        </div>
    </div>

    <div class="mt-3 mb-4">
        <small class="text-muted">
            <i class="fa-solid fa-info-circle me-1"></i>
            Las fotos aparecen automaticamente en las pantallas de <strong>Alta de Pieza</strong> y <strong>Control Anti-Lavado</strong> para vincularlas a piezas o clientes.
        </small>
    </div>
</div>

<!-- Photo viewer overlay -->
<div id="photo-viewer" class="photo-viewer d-none" onclick="closeViewer()">
    <img id="viewer-img" src="" alt="Foto ampliada" />
    <button type="button" class="btn-close-viewer" onclick="closeViewer()">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>

<!-- Data for JS -->
<input type="hidden" id="hid-user-id" value="@Model.IdUsuario" />

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/fotos-pwa.js"></script>
</body>
</html>
