<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Diamonds Web</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=20260608" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="fa-solid fa-gem me-2"></i>Diamonds Web
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/AntiLavado">
                            <i class="fa-solid fa-shield-halved me-1"></i>Control Anti-Lavado
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="fa-solid fa-user me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Logout">Salir</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid mt-3">
        @RenderBody()
    </main>

    <footer class="container-fluid text-center text-muted py-3 mt-4 border-top">
        <small>&copy; @DateTime.UtcNow.Year Diamonds-straat - Control Anti-Lavado (LFPIORPI Art. 17, Frac. VI)</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=20260608"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
