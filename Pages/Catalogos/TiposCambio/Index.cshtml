@page
@model DiamondsWeb.Pages.Catalogos.TiposCambio.IndexModel
@{
    ViewData["Title"] = "Tipos de Cambio";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-exchange-alt me-2"></i>Tipos de Cambio
    </div>
    <div class="card-body">
        <!-- Filtro -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label"><small>Filtrar por moneda</small></label>
                <select class="form-select form-select-sm" name="FiltroMoneda">
                    <option value="">-- Todas --</option>
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.IdMoneda" selected="@(Model.FiltroMoneda == m.IdMoneda)">@m.Moneda1</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-filter me-1"></i>Filtrar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Catalogos/TiposCambio" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Moneda</th>
                        <th class="text-end">Cotizacion</th>
                        <th class="text-end">Venta</th>
                        <th>Usuario</th>
                        <th>Fecha Captura</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TiposCambio.Any())
                    {
                        @foreach (var tc in Model.TiposCambio)
                        {
                            <tr>
                                <td>@tc.IdTipoCambio</td>
                                <td><span class="badge bg-info">@tc.Moneda</span></td>
                                <td class="text-end">@tc.TipoCambioCotizacion.ToString("N4")</td>
                                <td class="text-end">@tc.TipoCambioVenta.ToString("N4")</td>
                                <td>@tc.IdUsuario</td>
                                <td>@tc.FechaCaptura?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="id" value="@tc.IdTipoCambio" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"
                                                onclick="return confirm('Eliminar este tipo de cambio?')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron tipos de cambio.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Formulario Nuevo -->
        <hr />
        <h6><i class="fa-solid fa-plus me-2"></i>Registrar Tipo de Cambio</h6>
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label"><small>Moneda</small></label>
                <select class="form-select form-select-sm" name="NuevoIdMoneda" required>
                    <option value="">-- Seleccionar --</option>
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.IdMoneda">@m.Moneda1</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Cotizacion</small></label>
                <input type="number" class="form-control form-control-sm" name="NuevoCotizacion"
                       step="0.0001" min="0" required placeholder="0.0000" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Venta</small></label>
                <input type="number" class="form-control form-control-sm" name="NuevoVenta"
                       step="0.0001" min="0" required placeholder="0.0000" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Registrar
                </button>
            </div>
        </form>
    </div>
</div>
