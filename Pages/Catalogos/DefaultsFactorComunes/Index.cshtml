@page
@model DiamondsWeb.Pages.Catalogos.DefaultsFactorComunes.IndexModel
@{
    ViewData["Title"] = "Defaults Factor Impuesto y Divisor";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-sliders me-2"></i>Defaults Factor Impuesto y Divisor
    </div>
    <div class="card-body">
        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Impuesto</th>
                        <th>Divisor</th>
                        <th>Usuario</th>
                        <th>Fecha Captura</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Defaults.Any())
                    {
                        @foreach (var d in Model.Defaults)
                        {
                            <tr>
                                <td>@d.IdDefault</td>
                                <td>
                                    <span id="display-imp-@d.IdDefault">@d.DefaultImpuesto.ToString("N4")</span>
                                </td>
                                <td>
                                    <span id="display-div-@d.IdDefault">@d.DefaultDivisor.ToString("N4")</span>
                                </td>
                                <td>@d.IdUsuario</td>
                                <td>@d.FechaCaptura?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" id="actions-@d.IdDefault">
                                        <button type="button" class="btn btn-outline-warning" title="Editar"
                                                onclick="startEdit(@d.IdDefault)">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            <input type="hidden" name="id" value="@d.IdDefault" />
                                            <button type="submit" class="btn btn-outline-danger" title="Eliminar"
                                                    onclick="return confirm('Eliminar default #@d.IdDefault?')">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <form method="post" asp-page-handler="Edit" class="d-none" id="edit-form-@d.IdDefault">
                                        <div class="input-group input-group-sm">
                                            <input type="hidden" name="EditId" value="@d.IdDefault" />
                                            <input type="number" step="0.0001" class="form-control" name="EditImpuesto"
                                                   value="@d.DefaultImpuesto" placeholder="Impuesto" />
                                            <input type="number" step="0.0001" class="form-control" name="EditDivisor"
                                                   value="@d.DefaultDivisor" placeholder="Divisor" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm" onclick="cancelEdit(@d.IdDefault)">
                                                <i class="fa-solid fa-times"></i>
                                            </button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron defaults.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Formulario Nuevo -->
        <hr />
        <h6><i class="fa-solid fa-plus me-2"></i>Agregar Default</h6>
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label"><small>Impuesto</small></label>
                <input type="number" step="0.0001" class="form-control form-control-sm" name="NuevoImpuesto"
                       required placeholder="Ej: 1.16" />
            </div>
            <div class="col-md-4">
                <label class="form-label"><small>Divisor</small></label>
                <input type="number" step="0.0001" class="form-control form-control-sm" name="NuevoDivisor"
                       required placeholder="Ej: 1.16" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Crear Default
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function startEdit(id) {
        document.getElementById('display-imp-' + id).classList.add('d-none');
        document.getElementById('display-div-' + id).classList.add('d-none');
        document.getElementById('actions-' + id).classList.add('d-none');
        document.getElementById('edit-form-' + id).classList.remove('d-none');
    }
    function cancelEdit(id) {
        document.getElementById('display-imp-' + id).classList.remove('d-none');
        document.getElementById('display-div-' + id).classList.remove('d-none');
        document.getElementById('actions-' + id).classList.remove('d-none');
        document.getElementById('edit-form-' + id).classList.add('d-none');
    }
</script>
}
