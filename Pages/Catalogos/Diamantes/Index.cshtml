@page
@model DiamondsWeb.Pages.Catalogos.Diamantes.IndexModel
@{
    ViewData["Title"] = "Diamantes";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-gem me-2"></i>Diamantes</span>
        <span class="badge bg-light text-dark">@Model.Diamantes.Count registros (max 500)</span>
    </div>
    <div class="card-body">
        <!-- Filtro -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Codigo, descripcion, color, pureza..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Catalogos/Diamantes" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Codigo Barras</th>
                        <th>Descripcion</th>
                        <th class="text-end">Quilates</th>
                        <th>Color</th>
                        <th>Pureza</th>
                        <th>Corte</th>
                        <th>Obs1</th>
                        <th>Obs2</th>
                        <th class="text-end">Precio</th>
                        <th>Proveedor</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Diamantes.Any())
                    {
                        @foreach (var d in Model.Diamantes)
                        {
                            <tr>
                                <td><code>@d.CodigoBarras</code></td>
                                <td>@d.Descripcion</td>
                                <td class="text-end">@d.Quilates?.ToString("N2")</td>
                                <td>@(d.Color ?? "-")</td>
                                <td>@(d.Pureza ?? "-")</td>
                                <td>@(d.Corte ?? "-")</td>
                                <td><small>@(d.Obs1 ?? "-")</small></td>
                                <td><small>@(d.Obs2 ?? "-")</small></td>
                                <td class="text-end">@d.Precio?.ToString("C2")</td>
                                <td>@(d.NombreProveedor ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron diamantes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Diamantes.Any() && string.IsNullOrWhiteSpace(Model.Buscar))
        {
            <div class="text-center text-muted mt-3">
                <small>Use el campo de busqueda para consultar diamantes de la vista <code>vdiamantes</code>.</small>
            </div>
        }
    </div>
</div>
