@page
@using System.Globalization
@model DiamondsWeb.Pages.Catalogos.DefaultsUtilidadExtra.IndexModel
@{
    ViewData["Title"] = "Defaults Utilidad Extra";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-percent me-2"></i>Defaults Utilidad Extra seg&uacute;n precio por gramo
    </div>
    <div class="card-body">

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th class="text-end">Utilidad Extra</th>
                        <th>Usuario</th>
                        <th>Fecha Captura</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Defaults.Any())
                    {
                        @foreach (var d in Model.Defaults)
                        {
                            <tr>
                                <td>@d.IdDefaultUtilidadExtra</td>
                                <td class="text-end">
                                    <span class="display-val" id="display-ue-@d.IdDefaultUtilidadExtra">@d.DefaultUtilidadExtra1.ToString("N4")</span>
                                    <input type="number" step="0.0001" min="0.0001"
                                           class="form-control form-control-sm text-end edit-input d-none"
                                           id="input-ue-@d.IdDefaultUtilidadExtra"
                                           data-hidden="edit-ue-val-@d.IdDefaultUtilidadExtra"
                                           value="@d.DefaultUtilidadExtra1.ToString(CultureInfo.InvariantCulture)" />
                                </td>
                                <td>@d.NombreUsuario</td>
                                <td>
                                    <span class="utc-date" data-utc="@d.FechaCaptura.ToString("o")">
                                        @d.FechaCaptura.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <!-- Modo display -->
                                    <div id="actions-@d.IdDefaultUtilidadExtra">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-warning" title="Editar"
                                                    onclick="startEdit(@d.IdDefaultUtilidadExtra)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                                <input type="hidden" name="id" value="@d.IdDefaultUtilidadExtra" />
                                                <button type="submit" class="btn btn-outline-danger" title="Eliminar"
                                                        onclick="return confirm('Eliminar registro #@d.IdDefaultUtilidadExtra?')">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <!-- Modo edicion (oculto) -->
                                    <form method="post" asp-page-handler="Edit" class="d-none" id="edit-form-@d.IdDefaultUtilidadExtra">
                                        <input type="hidden" name="EditId" value="@d.IdDefaultUtilidadExtra" />
                                        <input type="hidden" name="EditUtilidadExtra" id="edit-ue-val-@d.IdDefaultUtilidadExtra"
                                               value="@d.DefaultUtilidadExtra1.ToString(CultureInfo.InvariantCulture)" />
                                        <div class="btn-group btn-group-sm">
                                            <button type="submit" class="btn btn-success" title="Guardar">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-secondary" title="Cancelar"
                                                    onclick="cancelEdit(@d.IdDefaultUtilidadExtra)">
                                                <i class="fa-solid fa-times"></i>
                                            </button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Formulario Nuevo -->
        <hr />
        <h6><i class="fa-solid fa-plus me-2"></i>Agregar Utilidad Extra</h6>
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label"><small>Utilidad Extra</small></label>
                <input type="number" step="0.0001" min="0.0001" class="form-control form-control-sm"
                       name="NuevaUtilidadExtra" required placeholder="Ej: 1.1500" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Crear
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function startEdit(id) {
        document.getElementById('actions-' + id).classList.add('d-none');
        document.getElementById('edit-form-' + id).classList.remove('d-none');
        var span = document.getElementById('display-ue-' + id);
        var input = document.getElementById('input-ue-' + id);
        span.classList.add('d-none');
        input.classList.remove('d-none');
        input.focus();
        input.select();
    }

    function cancelEdit(id) {
        document.getElementById('actions-' + id).classList.remove('d-none');
        document.getElementById('edit-form-' + id).classList.add('d-none');
        var span = document.getElementById('display-ue-' + id);
        var input = document.getElementById('input-ue-' + id);
        span.classList.remove('d-none');
        input.classList.add('d-none');
    }

    // Sync visible inputs to hidden form fields on change
    document.addEventListener('input', function(e) {
        if (e.target.classList.contains('edit-input')) {
            var hiddenId = e.target.dataset.hidden;
            if (hiddenId) {
                document.getElementById(hiddenId).value = e.target.value;
            }
        }
    });
</script>
}
