@page
@model DiamondsWeb.Pages.Catalogos.Divisores.IndexModel
@{
    ViewData["Title"] = "Divisores";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-divide me-2"></i>Divisores (Multiplicadores)
    </div>
    <div class="card-body">
        <!-- Filtro -->
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Buscar divisor..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Catalogos/Divisores" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>

        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Descripcion</th>
                        <th class="text-end">Divisor</th>
                        <th class="text-end">Multiplicador (1/Divisor)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Divisores.Any())
                    {
                        @foreach (var d in Model.Divisores)
                        {
                            <tr>
                                <td>@d.IdDivisor</td>
                                <td>
                                    <span id="display-@d.IdDivisor">@d.Descripcion</span>
                                    <form method="post" asp-page-handler="Edit" class="d-none" id="edit-form-@d.IdDivisor">
                                        <input type="hidden" name="EditId" value="@d.IdDivisor" />
                                        <div class="row g-2">
                                            <div class="col-7">
                                                <input type="text" class="form-control form-control-sm" name="EditDescripcion" value="@d.Descripcion" />
                                            </div>
                                            <div class="col-5">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" class="form-control" name="EditValor"
                                                           value="@d.ValorDivisor" step="0.000001" id="editDivisor-@d.IdDivisor"
                                                           oninput="calcMult('edit', @d.IdDivisor)" />
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <small class="text-muted">Multiplicador: <span id="editMult-@d.IdDivisor">@d.Multiplicador.ToString("N6")</span></small>
                                            </div>
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fa-solid fa-check me-1"></i>Guardar
                                                </button>
                                                <button type="button" class="btn btn-secondary btn-sm" onclick="cancelEdit(@d.IdDivisor)">
                                                    <i class="fa-solid fa-times me-1"></i>Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                                <td class="text-end">@d.ValorDivisor.ToString("N6")</td>
                                <td class="text-end">
                                    <span class="badge bg-info">@d.Multiplicador.ToString("N6")</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-warning" title="Editar"
                                                onclick="startEdit(@d.IdDivisor)">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            <input type="hidden" name="id" value="@d.IdDivisor" />
                                            <button type="submit" class="btn btn-outline-danger" title="Eliminar"
                                                    onclick="return confirm('Eliminar divisor @d.Descripcion?')">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No se encontraron divisores.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Formulario Nuevo -->
        <hr />
        <h6><i class="fa-solid fa-plus me-2"></i>Agregar Divisor</h6>
        <form method="post" asp-page-handler="Create" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label"><small>Descripcion</small></label>
                <input type="text" class="form-control form-control-sm" name="NuevaDescripcion" required
                       placeholder="Descripcion del divisor..." />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Divisor</small></label>
                <input type="number" class="form-control form-control-sm" name="NuevoValor"
                       step="0.000001" min="0.000001" required placeholder="0.000000" id="newDivisor"
                       oninput="calcMult('new', 0)" />
            </div>
            <div class="col-md-2">
                <label class="form-label"><small>Multiplicador</small></label>
                <input type="text" class="form-control form-control-sm" readonly id="newMult" value="0" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fa-solid fa-plus me-1"></i>Crear Divisor
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function startEdit(id) {
        document.getElementById('display-' + id).classList.add('d-none');
        document.getElementById('edit-form-' + id).classList.remove('d-none');
    }
    function cancelEdit(id) {
        document.getElementById('display-' + id).classList.remove('d-none');
        document.getElementById('edit-form-' + id).classList.add('d-none');
    }
    function calcMult(prefix, id) {
        if (prefix === 'new') {
            var val = parseFloat(document.getElementById('newDivisor').value);
            document.getElementById('newMult').value = val > 0 ? (1 / val).toFixed(6) : '0';
        } else {
            var val = parseFloat(document.getElementById('editDivisor-' + id).value);
            document.getElementById('editMult-' + id).textContent = val > 0 ? (1 / val).toFixed(6) : '0';
        }
    }
</script>
}
