@page
@model DiamondsWeb.Pages.Compuestas.IndexModel
@{
    ViewData["Title"] = "Piezas Compuestas";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@Model.ErrorMessage
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@Model.SuccessMessage
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        <i class="fa-solid fa-gem me-2"></i>Piezas Compuestas
    </h4>
    <a asp-page="Alta" class="btn btn-success">
        <i class="fa-solid fa-plus me-1"></i>Nueva Compuesta
    </a>
</div>

<!-- Filtros -->
<div class="filter-panel">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small text-muted">Buscar por codigo o descripcion</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                <input type="text" class="form-control" name="Buscar"
                       value="@Model.Buscar" placeholder="Codigo de barras o descripcion..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="fa-solid fa-filter me-1"></i>Filtrar
            </button>
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-rotate me-1"></i>Limpiar
            </a>
        </div>
    </form>
</div>

<!-- Tabla de Compuestas -->
<div class="table-responsive">
    <table class="table table-hover table-comp">
        <thead>
            <tr>
                <th>Codigo</th>
                <th>Descripcion</th>
                <th>Grupo</th>
                <th class="text-center">Componentes</th>
                <th class="text-end">Precio Total</th>
                <th>Fecha</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Compuestas.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                        No se encontraron piezas compuestas.
                    </td>
                </tr>
            }
            @foreach (var c in Model.Compuestas)
            {
                <tr>
                    <td>
                        <span class="badge bg-dark font-monospace">@c.CodigoBarras</span>
                    </td>
                    <td>@c.Descripcion</td>
                    <td><span class="badge bg-secondary">@c.Grupo</span></td>
                    <td class="text-center">
                        <span class="badge bg-info">@c.Componentes</span>
                    </td>
                    <td class="text-end fw-bold">
                        $@c.PrecioTotal.ToString("N0")
                    </td>
                    <td>
                        <span class="utc-date" data-utc="@c.FechaUltEdicion.ToString("o")">
                            @c.FechaUltEdicion.ToString("dd/MM/yyyy")
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <a asp-page="Alta" asp-route-cb="@c.CodigoBarras"
                               class="btn btn-outline-primary" title="Editar">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger"
                                    title="Eliminar"
                                    onclick="confirmarEliminar('@c.CodigoBarras', '@c.Descripcion.Replace("'", "\\'")') ">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Total -->
<div class="text-muted small">
    Mostrando @Model.Compuestas.Count compuesta(s)
</div>

<!-- Form oculto para eliminar -->
<form id="formEliminar" method="post" asp-page-handler="Eliminar" style="display:none">
    <input type="hidden" name="cb" id="eliminarCB" />
</form>

@section Scripts {
<script>
function confirmarEliminar(cb, desc) {
    if (confirm('Eliminar compuesta ' + cb + ' (' + desc + ')?\nSus componentes seran liberados.')) {
        document.getElementById('eliminarCB').value = cb;
        document.getElementById('formEliminar').submit();
    }
}
</script>
}
