@page
@model DiamondsWeb.Pages.Procesos.CambioStatus.IndexModel
@{
    ViewData["Title"] = "Cambio de Status";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Búsqueda por Código de Barras -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-arrows-rotate me-2"></i>Cambio de Status
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label"><small>Código de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="CodigoBarras"
                       value="@Model.CodigoBarras" placeholder="Escanee o ingrese código de barras..." autofocus />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Procesos/CambioStatus" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.PiezaEncontrada != null)
{
    var p = Model.PiezaEncontrada;

    <!-- Info de la Pieza -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <i class="fa-solid fa-circle-info me-2"></i>Información de la Pieza
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-3">
                    <strong>Código:</strong> @p.CodigoBarras
                </div>
                <div class="col-md-5">
                    <strong>Descripción:</strong> @p.Descripcion
                </div>
                <div class="col-md-4">
                    <strong>Precio:</strong> @p.Precio?.ToString("C")
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <strong>Proveedor:</strong> @p.NombreProveedor
                </div>
                <div class="col-md-3">
                    <strong>Grupo:</strong> @p.Grupo
                </div>
                <div class="col-md-3">
                    <strong>Status Actual:</strong>
                    <span class="badge bg-warning text-dark fs-6">@p.StatusNombre</span>
                </div>
                <div class="col-md-3">
                    <strong>Última Edición:</strong> @p.FechaUltEdicion?.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario de Cambio de Status -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-exchange-alt me-2"></i>Cambiar Status
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Cambiar" class="row g-3 align-items-end">
                <input type="hidden" name="CodigoBarras" value="@p.CodigoBarras" />
                <div class="col-md-5">
                    <label class="form-label"><small>Status Actual</small></label>
                    <input type="text" class="form-control form-control-sm" value="@p.StatusNombre" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><small>Nuevo Status</small></label>
                    <select name="NuevoStatus" class="form-select form-select-sm" required>
                        <option value="">-- Seleccione nuevo status --</option>
                        @foreach (var s in Model.StatusDisponibles)
                        {
                            <option value="@s.IdStatus"
                                    disabled="@(s.IdStatus == p.IdStatus ? "disabled" : null)">
                                @s.NombreStatus
                                @(s.IdStatus == p.IdStatus ? " (actual)" : "")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success btn-sm w-100"
                            onclick="return confirm('¿Confirma el cambio de status para la pieza @p.CodigoBarras?')">
                        <i class="fa-solid fa-check me-1"></i>Confirmar Cambio
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bitácora de Cambios -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <i class="fa-solid fa-clock-rotate-left me-2"></i>Bitácora de Cambios de Status
            <span class="badge bg-light text-dark ms-2">@Model.Bitacora.Count</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover table-striped table-sm mb-0">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th>#</th>
                            <th>Código</th>
                            <th>Status Anterior</th>
                            <th>Status Nuevo</th>
                            <th>Usuario</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Bitacora.Any())
                        {
                            @foreach (var b in Model.Bitacora)
                            {
                                <tr>
                                    <td>@b.IdCambioStatus</td>
                                    <td>@b.CodigoBarras</td>
                                    <td>
                                        <span class="badge bg-secondary">@b.StatusAnterior</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@b.StatusNuevo</span>
                                    </td>
                                    <td>@b.IdUsuario</td>
                                    <td>@b.FechaCambio?.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                    No hay registros en la bitácora para esta pieza.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
