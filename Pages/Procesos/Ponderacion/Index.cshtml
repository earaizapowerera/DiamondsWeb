@page
@model DiamondsWeb.Pages.Procesos.Ponderacion.IndexModel
@{
    ViewData["Title"] = "Ponderación de Costos Extra";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Formulario de Búsqueda -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-percent me-2"></i>Ponderación de Costos Extra
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label"><small>Id Remisión</small></label>
                <input type="number" class="form-control form-control-sm" name="IdRemision" id="txtIdRemision"
                       value="@Model.IdRemision" placeholder="Ej: 1234"
                       oninput="if(this.value) document.getElementById('txtIdFactura').value=''" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><small>Id Factura</small></label>
                <input type="number" class="form-control form-control-sm" name="IdFactura" id="txtIdFactura"
                       value="@Model.IdFactura" placeholder="Ej: 5678"
                       oninput="if(this.value) document.getElementById('txtIdRemision').value=''" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar Piezas
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Procesos/Ponderacion" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>
        <small class="text-muted">
            <i class="fa-solid fa-circle-info me-1"></i>
            Ingrese Id de Remisión <strong>o</strong> Id de Factura (son mutuamente excluyentes).
        </small>
    </div>
</div>

@if (Model.MostrarPreview)
{
    <!-- Preview de Piezas -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <i class="fa-solid fa-list me-2"></i>Piezas encontradas: @Model.PiezasAfectadas
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Código Barras</th>
                            <th>Descripción</th>
                            <th class="text-end">CN Pieza</th>
                            <th class="text-end">CN Peso</th>
                            <th class="text-end">Mano Obra Actual</th>
                            <th>Concepto Actual</th>
                            <th class="text-end">CN Total</th>
                            <th class="text-end">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PiezasPreview)
                        {
                        <tr>
                            <td><code>@p.CodigoBarras</code></td>
                            <td>@(p.Descripcion ?? "—")</td>
                            <td class="text-end">@p.CNPieza.ToString("N2")</td>
                            <td class="text-end">@p.CNPeso.ToString("N2")</td>
                            <td class="text-end @(p.CBManoObra > 0 ? "text-warning" : "")">
                                @p.CBManoObra.ToString("N2")
                            </td>
                            <td>@(p.DescripcionManoObra ?? "—")</td>
                            <td class="text-end">@p.CNTotal.ToString("N2")</td>
                            <td class="text-end">@p.Precio.ToString("N0")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.PiezasAfectadas > 50)
            {
                <small class="text-muted">
                    Mostrando 50 de @Model.PiezasAfectadas piezas.
                </small>
            }
        </div>
    </div>

    <!-- Formulario de Ponderación -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-calculator me-2"></i>Aplicar Ponderación
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Ponderar" id="formPonderar">
                <input type="hidden" name="IdRemision" value="@Model.IdRemision" />
                <input type="hidden" name="IdFactura" value="@Model.IdFactura" />

                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label class="form-label"><small>Concepto del costo extra</small></label>
                        <input type="text" class="form-control form-control-sm" name="Concepto"
                               placeholder="Ej: Flete, Seguro, Empaque..." required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label"><small>Porcentaje %</small></label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0.01" class="form-control form-control-sm"
                                   name="Porcentaje" id="txtPorcentaje" placeholder="Ej: 5.5" required />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="ModificarTodos" value="true"
                                   id="chkModificarTodos" />
                            <label class="form-check-label" for="chkModificarTodos">
                                <small>Modificar <strong>todas</strong> las piezas (incluso con costo previo)</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Preview del cálculo -->
                <div class="alert alert-light border mb-3" id="calculoPreview" style="display:none;">
                    <strong><i class="fa-solid fa-calculator me-1"></i>Vista previa del cálculo:</strong>
                    <br />
                    Mano de obra = (CN Pieza + CN Peso) / 100 × <span id="spanPorcentaje">0</span>%
                    <br />
                    Total = CB Pieza + CB Peso + Mano Obra
                    <br />
                    Precio = CN Total × Utilidad × Utilidad Extra × Impuesto / Divisor × TC Cotización
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-success btn-sm" onclick="confirmarPonderacion()">
                        <i class="fa-solid fa-check me-1"></i>Aplicar Ponderación a @Model.PiezasAfectadas piezas
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    // Mostrar preview del cálculo al ingresar porcentaje
    var txtPorcentaje = document.getElementById('txtPorcentaje');
    if (txtPorcentaje) {
        txtPorcentaje.addEventListener('input', function () {
            var val = parseFloat(this.value) || 0;
            var preview = document.getElementById('calculoPreview');
            var span = document.getElementById('spanPorcentaje');
            if (val > 0) {
                preview.style.display = 'block';
                span.textContent = val;
            } else {
                preview.style.display = 'none';
            }
        });
    }

    function confirmarPonderacion() {
        var porcentaje = document.getElementById('txtPorcentaje').value;
        var concepto = document.querySelector('input[name="Concepto"]').value;
        var piezas = @Model.PiezasAfectadas;

        if (!concepto || !porcentaje || parseFloat(porcentaje) <= 0) {
            alert('Complete el concepto y porcentaje antes de continuar.');
            return;
        }

        var msg = 'Se actualizarán ' + piezas + ' piezas con ' + porcentaje + '% de costo extra (' + concepto + ').\n\n¿Está seguro de continuar?';
        if (confirm(msg)) {
            document.getElementById('formPonderar').submit();
        }
    }
</script>
}
