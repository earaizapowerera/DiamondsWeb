@page
@model DiamondsWeb.Pages.Procesos.ActualizacionPieza.IndexModel
@{
    ViewData["Title"] = "Actualización de Pieza";
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
    <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Búsqueda de Pieza -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-pen-to-square me-2"></i>Actualización de Pieza
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label"><small>Código de Barras</small></label>
                <input type="text" class="form-control form-control-sm" name="CodigoBarras"
                       value="@Model.CodigoBarras" placeholder="Escanee o ingrese código de barras..." autofocus />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-3">
                <a href="/Procesos/ActualizacionPieza" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="fa-solid fa-eraser me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.PiezaEncontrada != null)
{
    var p = Model.PiezaEncontrada;

    <!-- Info Actual de la Pieza -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <i class="fa-solid fa-circle-info me-2"></i>Información Actual - @p.CodigoBarras
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Descripción:</strong> @p.Descripcion
                </div>
                <div class="col-md-4">
                    <strong>Proveedor:</strong> @p.NombreProveedor
                </div>
                <div class="col-md-4">
                    <strong>Precio:</strong> @p.Precio?.ToString("C")
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Factura:</strong> @(p.IdFactura?.ToString() ?? "Sin asignar")
                </div>
                <div class="col-md-3">
                    <strong>Remisión:</strong> @(p.IdRemision?.ToString() ?? "Sin asignar")
                </div>
                <div class="col-md-3">
                    <strong>Status:</strong> @p.StatusNombre
                </div>
                <div class="col-md-3">
                    <strong>Moneda:</strong> @(p.IdMoneda?.ToString() ?? "N/A")
                </div>
            </div>

            <!-- Costos Actuales -->
            <h6 class="mt-3"><i class="fa-solid fa-coins me-2"></i>Costos Actuales</h6>
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Concepto</th>
                            <th class="text-end">Costo Bruto (Extranjero)</th>
                            <th class="text-end">Costo Neto (Nacional)</th>
                            <th class="text-end">Descuento</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Pieza</td>
                            <td class="text-end">@p.CBPieza?.ToString("N2")</td>
                            <td class="text-end">@p.CNPieza?.ToString("N2")</td>
                            <td class="text-end">@p.DescPieza?.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Peso</td>
                            <td class="text-end">@p.CBPeso?.ToString("N2")</td>
                            <td class="text-end">@p.CNPeso?.ToString("N2")</td>
                            <td class="text-end">@p.DescPeso?.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Mano de Obra</td>
                            <td class="text-end">@p.CBManoObra?.ToString("N2")</td>
                            <td class="text-end">@p.CNManoObra?.ToString("N2")</td>
                            <td class="text-end">@p.DescManoObra?.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Factura</td>
                            <td class="text-end">@p.CBFactura?.ToString("N2")</td>
                            <td class="text-end">@p.CNFactura?.ToString("N2")</td>
                            <td class="text-end">@p.DescFactura?.ToString("N2")</td>
                        </tr>
                        <tr class="table-secondary">
                            <td><strong>TC Costo</strong></td>
                            <td class="text-end" colspan="3">@p.TCCosto?.ToString("N4")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Formulario de Actualización -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-pen me-2"></i>Actualizar Costos
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Actualizar">
                <input type="hidden" name="CodigoBarras" value="@p.CodigoBarras" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label"><small>Factura</small></label>
                        <select name="IdFactura" class="form-select form-select-sm">
                            <option value="">-- Sin cambio --</option>
                            @foreach (var f in Model.Facturas)
                            {
                                <option value="@f.IdFactura" selected="@(f.IdFactura == p.IdFactura?.ToString() ? "selected" : null)">
                                    @f.FolioFactura - @f.NombreProveedor
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label"><small>Tipo de Cambio Costo</small></label>
                        <input type="number" step="0.0001" class="form-control form-control-sm" name="TCCosto"
                               value="@p.TCCosto" id="tcCosto" />
                    </div>
                </div>

                <h6 class="mt-3">Costos de Pieza</h6>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label"><small>Bruto (Extranjero)</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" name="CBPieza"
                               value="@p.CBPieza" id="cbPieza" oninput="calcularNetoPieza()" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label"><small>Descuento</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" name="DescPieza"
                               value="@p.DescPieza" id="descPieza" oninput="calcularNetoPieza()" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label"><small>Neto (Nacional)</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" name="CNPieza"
                               value="@p.CNPieza" id="cnPieza" readonly />
                    </div>
                </div>

                <h6 class="mt-3">Costos de Factura</h6>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label"><small>Bruto (Extranjero)</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" name="CBFactura"
                               value="@p.CBFactura" id="cbFactura" oninput="calcularNetoFactura()" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label"><small>Descuento</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" name="DescFactura"
                               value="@p.DescFactura" id="descFactura" oninput="calcularNetoFactura()" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label"><small>Neto (Nacional)</small></label>
                        <input type="number" step="0.01" class="form-control form-control-sm" name="CNFactura"
                               value="@p.CNFactura" id="cnFactura" readonly />
                    </div>
                </div>

                <div class="text-end mt-3">
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    function calcularNetoPieza() {
        var bruto = parseFloat(document.getElementById('cbPieza').value) || 0;
        var desc = parseFloat(document.getElementById('descPieza').value) || 0;
        var tc = parseFloat(document.getElementById('tcCosto').value) || 1;
        var neto = (bruto - desc) * tc;
        document.getElementById('cnPieza').value = neto.toFixed(2);
    }

    function calcularNetoFactura() {
        var bruto = parseFloat(document.getElementById('cbFactura').value) || 0;
        var desc = parseFloat(document.getElementById('descFactura').value) || 0;
        var tc = parseFloat(document.getElementById('tcCosto').value) || 1;
        var neto = (bruto - desc) * tc;
        document.getElementById('cnFactura').value = neto.toFixed(2);
    }
</script>
}
