@page
@model DiamondsWeb.Pages.Piezas.IndexModel
@{
    ViewData["Title"] = "Piezas Sencillas";
}

<link rel="stylesheet" href="/css/piezas.css?v=20260615" />

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-check-circle me-2"></i>@Model.MensajeExito
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Alert dinamico para resultado de eliminacion -->
<div id="alertEliminar" class="alert alert-dismissible fade show d-none" role="alert">
    <span id="alertEliminarMsg"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>

<!-- Barra de herramientas -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0"><i class="fa-solid fa-gem me-2"></i>Piezas Sencillas</h5>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Alta" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i>Nueva Pieza
        </a>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Buscar</label>
                <input type="text" name="Buscar" value="@Model.Buscar" class="form-control form-control-sm"
                       placeholder="Codigo, descripcion..." />
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Remision</label>
                <select name="IdRemision" class="form-select form-select-sm" id="selRemision">
                    <option value="">-- Todas --</option>
                    @foreach (var r in Model.Remisiones)
                    {
                        <option value="@r.IdRemision" selected="@(Model.IdRemision == r.IdRemision)">
                            @r.IdRemision - @r.NombreProveedor (@r.NumeroRemision)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Grupo</label>
                <select name="IdGrupo" class="form-select form-select-sm" id="selGrupo">
                    <option value="">-- Todos --</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" selected="@(Model.IdGrupo == g.IdGrupo)">@g.Grupo</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-search me-1"></i>Buscar
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-rotate-right me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Resumen de remision seleccionada -->
@if (Model.RemisionActual != null && Model.Totales != null)
{
<div class="card mb-3 border-primary">
    <div class="card-body py-2">
        <div class="row">
            <div class="col-md-4">
                <small class="text-muted">Remision #@Model.RemisionActual.IdRemision</small>
                <div><strong>@Model.RemisionActual.NombreProveedor</strong> - @Model.RemisionActual.NumeroRemision</div>
                @if (Model.RemisionActual.Consignacion)
                {
                    <span class="badge bg-warning text-dark">Consignacion</span>
                }
            </div>
            <div class="col-md-8">
                <div class="row text-center">
                    <div class="col">
                        <small class="text-muted d-block">Piezas</small>
                        <strong>@Model.Totales.Piezas</strong>
                    </div>
                    <div class="col">
                        <small class="text-muted d-block">Peso</small>
                        <strong>@Model.Totales.Peso.ToString("N2")</strong>
                    </div>
                    <div class="col">
                        <small class="text-muted d-block">Bruto Total</small>
                        <strong>@Model.Totales.BrutoTotal.ToString("C2")</strong>
                    </div>
                    <div class="col">
                        <small class="text-muted d-block">Neto Total</small>
                        <strong>@Model.Totales.NetoTotal.ToString("C2")</strong>
                    </div>
                    <div class="col">
                        <small class="text-muted d-block">Bruto Nota</small>
                        <strong>@Model.Totales.BrutoNota.ToString("C2")</strong>
                    </div>
                    <div class="col">
                        <small class="text-muted d-block">Neto Nota</small>
                        <strong>@Model.Totales.NetoNota.ToString("C2")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}

<!-- Tabla de piezas -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                        <th>Grupo</th>
                        <th class="text-end">C. Bruto</th>
                        <th class="text-end">C. Neto</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Peso</th>
                        <th>Kilates</th>
                        <th>Modelo</th>
                        <th>Linea</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Piezas.Count == 0)
                    {
                    <tr>
                        <td colspan="11" class="text-center text-muted py-3">
                            <i class="fa-solid fa-inbox me-2"></i>No se encontraron piezas
                        </td>
                    </tr>
                    }
                    @foreach (var p in Model.Piezas)
                    {
                    <tr id="row-@p.CodigoBarras">
                        <td><code>@p.CodigoBarras</code></td>
                        <td class="text-truncate" style="max-width: 250px;" title="@p.Descripcion">@p.Descripcion</td>
                        <td>@p.NombreGrupo</td>
                        <td class="text-end">@p.CBTotal.ToString("N2")</td>
                        <td class="text-end">@p.CNTotal.ToString("N2")</td>
                        <td class="text-end fw-bold">$@p.Precio.ToString("N0")</td>
                        <td class="text-end">@(p.Peso > 0 ? p.Peso.ToString("N2") : "")</td>
                        <td>@p.Kilates</td>
                        <td>@p.Modelo</td>
                        <td>@p.Linea</td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Alta" asp-route-cb="@p.CodigoBarras" class="btn btn-outline-primary btn-sm" title="Modificar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar"
                                        title="Eliminar"
                                        data-cb="@p.CodigoBarras"
                                        data-desc="@p.Descripcion">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de eliminacion con permisos -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title" id="modalEliminarLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Eliminar Pieza
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Estado de carga -->
                <div id="elimLoading" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2">Verificando permisos...</span>
                </div>

                <!-- Contenido principal (oculto hasta que cargue) -->
                <div id="elimContent" class="d-none">
                    <!-- Info de la pieza -->
                    <div class="mb-3 p-2 bg-light rounded">
                        <div class="row">
                            <div class="col-4"><small class="text-muted">Codigo:</small></div>
                            <div class="col-8"><code id="elimCB"></code></div>
                        </div>
                        <div class="row">
                            <div class="col-4"><small class="text-muted">Descripcion:</small></div>
                            <div class="col-8"><span id="elimDesc"></span></div>
                        </div>
                        <div class="row">
                            <div class="col-4"><small class="text-muted">Fecha captura:</small></div>
                            <div class="col-8"><span id="elimFecha"></span></div>
                        </div>
                    </div>

                    <!-- Status badges -->
                    <div id="elimBadges" class="mb-3">
                        <span id="badgeEtiqueta" class="badge me-1 d-none"></span>
                        <span id="badgeVentana" class="badge me-1 d-none"></span>
                        <span id="badgeSupervisor" class="badge me-1 d-none"></span>
                    </div>

                    <!-- Alerta de autorizacion requerida -->
                    <div id="elimAlertAuth" class="alert alert-warning py-2 d-none">
                        <i class="fa-solid fa-lock me-1"></i>
                        <span id="elimAuthMotivo"></span>
                    </div>

                    <!-- Motivo de cancelacion -->
                    <div class="mb-3">
                        <label for="elimMotivo" class="form-label form-label-sm">
                            Motivo de cancelacion <small class="text-muted">(opcional)</small>
                        </label>
                        <textarea id="elimMotivo" class="form-control form-control-sm" rows="2"
                                  placeholder="Razon por la que se elimina esta pieza..."></textarea>
                    </div>

                    <!-- Seccion de autorizacion de supervisor -->
                    <div id="elimSupervisorSection" class="d-none">
                        <hr>
                        <h6 class="text-muted mb-2">
                            <i class="fa-solid fa-user-shield me-1"></i>Autorizacion de Supervisor
                        </h6>
                        <div class="mb-2">
                            <label for="elimSuperNombre" class="form-label form-label-sm mb-0">Nombre del supervisor</label>
                            <input type="text" id="elimSuperNombre" class="form-control form-control-sm"
                                   placeholder="Nombre del usuario supervisor" autocomplete="off" />
                        </div>
                        <div class="mb-2">
                            <label for="elimSuperPassword" class="form-label form-label-sm mb-0">Contrasena</label>
                            <input type="password" id="elimSuperPassword" class="form-control form-control-sm"
                                   placeholder="Contrasena del supervisor" autocomplete="off" />
                        </div>
                        <div id="elimAuthError" class="text-danger small d-none"></div>
                    </div>
                </div>

                <!-- Error general -->
                <div id="elimError" class="alert alert-danger py-2 d-none">
                    <i class="fa-solid fa-circle-xmark me-1"></i><span id="elimErrorMsg"></span>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i>Cancelar
                </button>
                <button type="button" id="btnConfirmarEliminar" class="btn btn-danger btn-sm" disabled>
                    <i class="fa-solid fa-trash me-1"></i>Eliminar Pieza
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Searchable dropdowns con TomSelect
    if (typeof TomSelect !== 'undefined') {
        var selRemision = document.getElementById('selRemision');
        if (selRemision) new TomSelect(selRemision, { allowEmptyOption: true });
        var selGrupo = document.getElementById('selGrupo');
        if (selGrupo) new TomSelect(selGrupo, { allowEmptyOption: true });
    }

    // --- Eliminacion con permisos ---
    var modalEl = document.getElementById('modalEliminar');
    var modal = new bootstrap.Modal(modalEl);
    var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var currentCB = '';
    var requiresAuth = false;

    // Click en boton eliminar → verificar permisos y abrir modal
    document.querySelectorAll('.btn-eliminar').forEach(function(btn) {
        btn.addEventListener('click', function() {
            currentCB = this.dataset.cb;
            var desc = this.dataset.desc;
            abrirModalEliminar(currentCB, desc);
        });
    });

    function abrirModalEliminar(cb, desc) {
        // Reset modal state
        document.getElementById('elimLoading').classList.remove('d-none');
        document.getElementById('elimContent').classList.add('d-none');
        document.getElementById('elimError').classList.add('d-none');
        document.getElementById('elimSupervisorSection').classList.add('d-none');
        document.getElementById('elimAlertAuth').classList.add('d-none');
        document.getElementById('elimAuthError').classList.add('d-none');
        document.getElementById('elimMotivo').value = '';
        document.getElementById('elimSuperNombre').value = '';
        document.getElementById('elimSuperPassword').value = '';
        document.getElementById('btnConfirmarEliminar').disabled = true;
        requiresAuth = false;

        modal.show();

        // Fetch permisos via AJAX
        fetch('/Piezas?handler=VerificarPermisoEliminar&codigoBarras=' + encodeURIComponent(cb))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('elimLoading').classList.add('d-none');

                if (data.motivoRequerimiento === 'La pieza no existe.') {
                    document.getElementById('elimError').classList.remove('d-none');
                    document.getElementById('elimErrorMsg').textContent = 'La pieza no existe.';
                    return;
                }

                document.getElementById('elimContent').classList.remove('d-none');

                // Mostrar info de la pieza
                document.getElementById('elimCB').textContent = data.codigoBarras || cb;
                document.getElementById('elimDesc').textContent = data.descripcion || desc || '';
                document.getElementById('elimFecha').textContent = data.fechaCaptura
                    ? new Date(data.fechaCaptura).toLocaleString()
                    : 'N/A';

                // Badges de estado
                mostrarBadge('badgeEtiqueta',
                    data.etiquetaImpresa ? 'Etiqueta impresa' : 'Sin etiqueta',
                    data.etiquetaImpresa ? 'bg-warning text-dark' : 'bg-secondary');
                mostrarBadge('badgeVentana',
                    data.dentroDeVentana ? 'Dentro de 2 hrs' : 'Fuera de ventana',
                    data.dentroDeVentana ? 'bg-success' : 'bg-secondary');
                mostrarBadge('badgeSupervisor',
                    data.esSupervisor ? 'Supervisor' : 'Usuario normal',
                    data.esSupervisor ? 'bg-info' : 'bg-secondary');

                // Mostrar seccion de autorizacion si es necesario
                requiresAuth = data.requiereAutorizacion;
                if (requiresAuth) {
                    document.getElementById('elimAlertAuth').classList.remove('d-none');
                    document.getElementById('elimAuthMotivo').textContent = data.motivoRequerimiento;
                    document.getElementById('elimSupervisorSection').classList.remove('d-none');
                }

                document.getElementById('btnConfirmarEliminar').disabled = false;
            })
            .catch(function(err) {
                document.getElementById('elimLoading').classList.add('d-none');
                document.getElementById('elimError').classList.remove('d-none');
                document.getElementById('elimErrorMsg').textContent = 'Error al verificar permisos: ' + err.message;
            });
    }

    function mostrarBadge(id, text, cssClass) {
        var el = document.getElementById(id);
        el.textContent = text;
        el.className = 'badge me-1 ' + cssClass;
    }

    // Confirmar eliminacion
    document.getElementById('btnConfirmarEliminar').addEventListener('click', function() {
        var btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Eliminando...';

        var body = {
            codigoBarras: currentCB,
            motivo: document.getElementById('elimMotivo').value || null
        };

        if (requiresAuth) {
            var nombre = document.getElementById('elimSuperNombre').value.trim();
            var password = document.getElementById('elimSuperPassword').value;
            if (!nombre || !password) {
                document.getElementById('elimAuthError').textContent = 'Ingrese nombre y contrasena del supervisor.';
                document.getElementById('elimAuthError').classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-trash me-1"></i>Eliminar Pieza';
                return;
            }
            body.supervisorNombre = nombre;
            body.supervisorPassword = password;
        }

        fetch('/Piezas?handler=EliminarConPermiso', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify(body)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                modal.hide();
                // Eliminar fila de la tabla
                var row = document.getElementById('row-' + currentCB);
                if (row) {
                    row.style.transition = 'opacity 0.3s';
                    row.style.opacity = '0';
                    setTimeout(function() { row.remove(); }, 300);
                }
                mostrarAlerta('success', data.mensaje || 'Pieza eliminada correctamente.');
            } else {
                // Mostrar error en el modal
                if (data.error && data.error.indexOf('supervisor') >= 0) {
                    document.getElementById('elimAuthError').textContent = data.error;
                    document.getElementById('elimAuthError').classList.remove('d-none');
                } else {
                    document.getElementById('elimError').classList.remove('d-none');
                    document.getElementById('elimErrorMsg').textContent = data.error || 'Error desconocido.';
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-trash me-1"></i>Eliminar Pieza';
            }
        })
        .catch(function(err) {
            document.getElementById('elimError').classList.remove('d-none');
            document.getElementById('elimErrorMsg').textContent = 'Error de red: ' + err.message;
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-trash me-1"></i>Eliminar Pieza';
        });
    });

    // Reset al cerrar modal
    modalEl.addEventListener('hidden.bs.modal', function() {
        document.getElementById('btnConfirmarEliminar').innerHTML = '<i class="fa-solid fa-trash me-1"></i>Eliminar Pieza';
        document.getElementById('btnConfirmarEliminar').disabled = true;
    });

    function mostrarAlerta(tipo, mensaje) {
        var alert = document.getElementById('alertEliminar');
        alert.className = 'alert alert-' + (tipo === 'success' ? 'success' : 'danger') + ' alert-dismissible fade show';
        document.getElementById('alertEliminarMsg').innerHTML =
            '<i class="fa-solid fa-' + (tipo === 'success' ? 'check-circle' : 'circle-xmark') + ' me-2"></i>' + mensaje;
        alert.classList.remove('d-none');
        // Auto-dismiss after 5s
        setTimeout(function() {
            alert.classList.add('d-none');
        }, 5000);
    }
});
</script>
}
