@page
@model DiamondsWeb.Pages.Actualizaciones.IndexModel
@{
    ViewData["Title"] = "Actualización desde Facturas";
    var mensaje = TempData["Mensaje"] as string ?? Model.Mensaje;
    var mensajeTipo = TempData["MensajeTipo"] as string ?? Model.MensajeTipo ?? "info";
    var tieneFactura = Model.FacturaActual != null;
}

<style>
    .grid-container { max-height: 400px; overflow-y: auto; }
    .grid-container table { font-size: 0.85rem; }
    .factura-panel { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
    .cost-input { width: 110px; }
    .pieza-row { cursor: pointer; }
    .pieza-row:hover { background-color: #e3f2fd !important; }
    .pieza-row.selected { background-color: #bbdefb !important; }
    .btn-assign { padding: 2px 8px; font-size: 0.75rem; }
    .totales-panel { background: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 8px; padding: 0.75rem; }
    .costos-panel { background: #fff8e1; border: 1px solid #ffecb3; border-radius: 8px; padding: 0.75rem; }
    .remision-group { background: #fff3e0; border: 1px solid #ffe0b2; border-radius: 6px; padding: 0.5rem; }
    .facturas-list { max-height: 250px; overflow-y: auto; }
    .factura-item { cursor: pointer; padding: 6px 10px; border-bottom: 1px solid #eee; }
    .factura-item:hover { background: #e3f2fd; }
    .factura-item.active { background: #bbdefb; font-weight: 600; }
</style>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-@mensajeTipo alert-dismissible fade show" role="alert">
        <i class="fa-solid @(mensajeTipo == "success" ? "fa-check-circle" : mensajeTipo == "danger" ? "fa-exclamation-triangle" : "fa-info-circle") me-2"></i>
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- ═══════ COLUMNA IZQUIERDA: Factura + Controles ═══════ -->
    <div class="col-lg-5">

        <!-- Buscador de facturas -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span><i class="fa-solid fa-file-invoice me-2"></i>Facturas</span>
                <div>
                    <button type="button" class="btn btn-sm btn-success" id="btnNuevaFactura" title="Nueva Factura (F2)">
                        <i class="fa-solid fa-plus"></i> Nueva
                    </button>
                    @if (tieneFactura)
                    {
                        <button type="button" class="btn btn-sm btn-primary" id="btnEditarFactura" title="Editar Factura (F3)">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <form method="post" asp-page-handler="EliminarFactura" class="d-inline"
                              onsubmit="return confirm('¿Eliminar esta factura?');">
                            <input type="hidden" name="idFactura" value="@Model.FacturaActual!.IdFactura" />
                            <button type="submit" class="btn btn-sm btn-danger" title="Eliminar Factura">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="card-body py-2">
                <form method="post" asp-page-handler="BuscarFactura" class="mb-2">
                    <div class="input-group input-group-sm">
                        <input type="text" name="filtroFacturas" class="form-control"
                               placeholder="Buscar por folio, proveedor, razón social..."
                               value="@Model.FiltroFacturas" />
                        <button class="btn btn-outline-secondary" type="submit" title="Buscar (F6)">
                            <i class="fa-solid fa-search"></i>
                        </button>
                    </div>
                </form>
                <div class="facturas-list">
                    @if (Model.FacturasRecientes.Any())
                    {
                        @foreach (var f in Model.FacturasRecientes)
                        {
                            <form method="post" asp-page-handler="SeleccionarFactura" class="m-0 p-0">
                                <input type="hidden" name="idFactura" value="@f.IdFactura" />
                                <button type="submit"
                                        class="factura-item d-block w-100 text-start border-0 bg-transparent @(tieneFactura && Model.FacturaActual!.IdFactura == f.IdFactura ? "active" : "")">
                                    <div class="d-flex justify-content-between">
                                        <span><strong>@f.FolioFactura</strong> <small class="text-muted">(#@f.IdFactura)</small></span>
                                        <small class="text-muted">@f.FechaFactura.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <small class="text-muted">@f.NombreProveedor — @f.RazonSocialProveedor</small>
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-3"><small>No se encontraron facturas</small></div>
                    }
                </div>
            </div>
        </div>

        <!-- Formulario Nueva/Editar Factura (oculto por defecto) -->
        <div class="card mb-3" id="formFacturaCard" style="display:none;">
            <div class="card-header py-2">
                <i class="fa-solid fa-file-circle-plus me-2"></i><span id="formFacturaTitulo">Nueva Factura</span>
            </div>
            <div class="card-body">
                <form method="post" id="formFactura">
                    <input type="hidden" name="idFactura" id="frmIdFactura" />
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Folio Factura</label>
                            <input type="text" name="folioFactura" id="frmFolioFactura"
                                   class="form-control form-control-sm" required maxlength="15" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Fecha Factura</label>
                            <input type="date" name="fechaFactura" id="frmFechaFactura"
                                   class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Proveedor</label>
                            <select name="proveedor" id="frmProveedor" class="form-select form-select-sm" required>
                                <option value="">-- Seleccionar --</option>
                                @foreach (var p in Model.Proveedores)
                                {
                                    <option value="@p.Proveedor">@p.NombreProveedor</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Razón Social</label>
                            <select name="idRazonSocialProveedor" id="frmRazonSocial" class="form-select form-select-sm" required>
                                <option value="">-- Seleccione proveedor primero --</option>
                                @foreach (var rs in Model.RazonesSociales)
                                {
                                    <option value="@rs.IdRazonSocialProveedor">@rs.RazonSocialProveedor</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Pedimento</label>
                            <input type="text" name="pedimento" id="frmPedimento"
                                   class="form-control form-control-sm" maxlength="30" />
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-success" id="btnGuardarFactura">
                            <i class="fa-solid fa-save me-1"></i>Guardar
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary" id="btnCancelarFactura">
                            Cancelar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Datos de Factura Seleccionada -->
        @if (tieneFactura)
        {
            <div class="factura-panel">
                <div class="row">
                    <div class="col-md-6">
                        <small class="text-muted">Folio:</small>
                        <strong>@Model.FacturaActual!.FolioFactura</strong>
                        <small class="text-muted ms-2">ID: @Model.FacturaActual.IdFactura</small>
                    </div>
                    <div class="col-md-6 text-end">
                        <small class="text-muted">Fecha:</small>
                        <strong>@Model.FacturaActual.FechaFactura.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>
                <div class="row mt-1">
                    <div class="col-md-6">
                        <small class="text-muted">Proveedor:</small>
                        @Model.FacturaActual.NombreProveedor
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Razón Social:</small>
                        @Model.FacturaActual.RazonSocialProveedor
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.FacturaActual.Pedimento))
                {
                    <div class="mt-1">
                        <small class="text-muted">Pedimento:</small> @Model.FacturaActual.Pedimento
                    </div>
                }
            </div>

            <!-- Totales -->
            <div class="totales-panel mb-3">
                <div class="row text-center">
                    <div class="col-4">
                        <small class="text-muted d-block">Piezas</small>
                        <strong>@Model.Totales.CantidadPiezas</strong>
                    </div>
                    <div class="col-4">
                        <small class="text-muted d-block">Total Bruto</small>
                        <strong>@Model.Totales.Bruto.ToString("N2")</strong>
                    </div>
                    <div class="col-4">
                        <small class="text-muted d-block">Total Neto</small>
                        <strong>@Model.Totales.Neto.ToString("N2")</strong>
                    </div>
                </div>
            </div>
        }

        <!-- Búsqueda de piezas disponibles + Panel de costos -->
        @if (tieneFactura)
        {
            <div class="card mb-3">
                <div class="card-header py-2">
                    <i class="fa-solid fa-search me-2"></i>Buscar Piezas a Actualizar
                </div>
                <div class="card-body py-2">
                    <form method="post" asp-page-handler="BuscarPiezas">
                        <input type="hidden" name="idFactura" value="@Model.FacturaActual!.IdFactura" />
                        <div class="input-group input-group-sm">
                            <input type="text" name="filtroPiezas" class="form-control"
                                   id="txtFiltroPiezas"
                                   placeholder="Código de barras, observaciones, remisión..."
                                   value="@Model.FiltroPiezas" />
                            <button class="btn btn-outline-primary" type="submit" title="Buscar (F5)">
                                <i class="fa-solid fa-search"></i> Buscar
                            </button>
                        </div>
                    </form>

                    <!-- Panel de Costos (visible al seleccionar pieza) -->
                    <div class="costos-panel mt-2" id="panelCostos" style="display:none;">
                        <form method="post" asp-page-handler="AsignarPieza" id="formAsignar">
                            <input type="hidden" name="idFactura" value="@Model.FacturaActual!.IdFactura" />
                            <input type="hidden" name="codigoBarras" id="costCodigo" />
                            <input type="hidden" name="filtroPiezas" value="@Model.FiltroPiezas" />
                            <div class="mb-1">
                                <small class="text-muted">Pieza seleccionada:</small>
                                <strong id="costCodigoLabel">—</strong>
                                <span class="text-muted" id="costObs2Label"></span>
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <label class="form-label form-label-sm mb-0">Costo Bruto (CB)</label>
                                    <input type="number" name="cbTotal" id="costCB"
                                           class="form-control form-control-sm" step="0.01" min="0" required />
                                </div>
                                <div class="col">
                                    <label class="form-label form-label-sm mb-0">Costo Neto (CN)</label>
                                    <input type="number" name="cnTotal" id="costCN"
                                           class="form-control form-control-sm" step="0.01" min="0" required />
                                </div>
                                <div class="col">
                                    <label class="form-label form-label-sm mb-0">Tipo Cambio</label>
                                    <input type="number" name="tcCosto" id="costTC"
                                           class="form-control form-control-sm" step="0.0001" min="0.0001" value="1" required />
                                </div>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col">
                                    <small class="text-muted">Bruto MN:</small>
                                    <strong id="costBrutoMN">0.00</strong>
                                </div>
                                <div class="col">
                                    <small class="text-muted">Neto MN:</small>
                                    <strong id="costNetoMN">0.00</strong>
                                </div>
                                <div class="col text-end">
                                    <button type="submit" class="btn btn-sm btn-success" title="Asignar (Enter)">
                                        <i class="fa-solid fa-arrow-right me-1"></i>Asignar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Asignar Remisión Completa -->
                    @if (Model.PiezasDisponibles.Any(p => p.IdRemision.HasValue))
                    {
                        <div class="remision-group mt-2">
                            <form method="post" asp-page-handler="AsignarRemision"
                                  onsubmit="return confirm('¿Asignar toda la remisión a esta factura?');">
                                <input type="hidden" name="idFactura" value="@Model.FacturaActual!.IdFactura" />
                                <input type="hidden" name="filtroPiezas" value="@Model.FiltroPiezas" />
                                <div class="row g-2 align-items-end">
                                    <div class="col-auto">
                                        <label class="form-label form-label-sm mb-0">Remisión</label>
                                        <select name="idRemision" class="form-select form-select-sm" required>
                                            @foreach (var rem in Model.PiezasDisponibles
                                                .Where(p => p.IdRemision.HasValue)
                                                .Select(p => p.IdRemision!.Value)
                                                .Distinct()
                                                .OrderBy(r => r))
                                            {
                                                <option value="@rem">@rem</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-auto">
                                        <label class="form-label form-label-sm mb-0">Tipo de Cambio</label>
                                        <input type="number" name="tipoCambio" class="form-control form-control-sm cost-input"
                                               step="0.0001" min="0.0001" value="1" required />
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-sm btn-warning">
                                            <i class="fa-solid fa-layer-group me-1"></i>Remisión Completa
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ═══════ COLUMNA DERECHA: Grids ═══════ -->
    <div class="col-lg-7">

        @if (tieneFactura)
        {
            <!-- Grid: Piezas disponibles -->
            @if (Model.PiezasDisponibles.Any())
            {
                <div class="card mb-3">
                    <div class="card-header py-2">
                        <i class="fa-solid fa-cubes me-2"></i>Piezas Disponibles
                        <span class="badge bg-secondary ms-1">@Model.PiezasDisponibles.Count</span>
                        <small class="text-muted ms-2">Click en una fila para seleccionar</small>
                    </div>
                    <div class="grid-container">
                        <table class="table table-sm table-striped table-hover mb-0" id="tblDisponibles">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th>Obs2</th>
                                    <th>Remisión</th>
                                    <th class="text-end">CB Pieza</th>
                                    <th class="text-end">CN Pieza</th>
                                    <th class="text-end">TC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PiezasDisponibles)
                                {
                                    <tr class="pieza-row"
                                        data-codigo="@p.CodigoBarras"
                                        data-obs2="@p.Obs2"
                                        data-cb="@(p.CBPieza ?? 0)"
                                        data-cn="@(p.CNPieza ?? 0)"
                                        data-tc="@(p.TCCosto ?? 1)"
                                        data-desc-pieza="@(p.DescPieza ?? 0)">
                                        <td><code>@p.CodigoBarras</code></td>
                                        <td><small>@p.Descripcion</small></td>
                                        <td>@p.Obs2</td>
                                        <td>@(p.Remision ?? p.IdRemision?.ToString())</td>
                                        <td class="text-end">@(p.CBPieza?.ToString("N2") ?? "-")</td>
                                        <td class="text-end">@(p.CNPieza?.ToString("N2") ?? "-")</td>
                                        <td class="text-end">@(p.TCCosto?.ToString("N4") ?? "1.0000")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.FiltroPiezas))
            {
                <div class="alert alert-info">
                    <i class="fa-solid fa-info-circle me-2"></i>No se encontraron piezas disponibles con &quot;<strong>@Model.FiltroPiezas</strong>&quot;.
                </div>
            }

            <!-- Grid: Piezas vinculadas a la factura -->
            <div class="card">
                <div class="card-header py-2">
                    <i class="fa-solid fa-link me-2"></i>Piezas en Factura #@Model.FacturaActual!.IdFactura
                    <span class="badge bg-primary ms-1">@Model.PiezasVinculadas.Count</span>
                </div>
                @if (Model.PiezasVinculadas.Any())
                {
                    <div class="grid-container">
                        <table class="table table-sm table-striped table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Código</th>
                                    <th>Obs2</th>
                                    <th class="text-end">CB Factura</th>
                                    <th class="text-end">CN Factura</th>
                                    <th class="text-end">TC</th>
                                    <th class="text-end">CB Pieza</th>
                                    <th class="text-end">CN Pieza</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PiezasVinculadas)
                                {
                                    <tr>
                                        <td><code>@p.CodigoBarras</code></td>
                                        <td>@p.Obs2</td>
                                        <td class="text-end">@(p.CBFactura?.ToString("N2") ?? "-")</td>
                                        <td class="text-end">@(p.CNFactura?.ToString("N2") ?? "-")</td>
                                        <td class="text-end">@(p.TCCosto?.ToString("N4") ?? "-")</td>
                                        <td class="text-end">@(p.CBPieza?.ToString("N2") ?? "-")</td>
                                        <td class="text-end">@(p.CNPieza?.ToString("N2") ?? "-")</td>
                                        <td>
                                            <form method="post" asp-page-handler="QuitarPieza" class="d-inline"
                                                  onsubmit="return confirm('¿Quitar esta pieza de la factura?');">
                                                <input type="hidden" name="idFactura" value="@Model.FacturaActual.IdFactura" />
                                                <input type="hidden" name="codigoBarras" value="@p.CodigoBarras" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-assign"
                                                        title="Quitar de factura">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body text-center text-muted py-4">
                        <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                        No hay piezas vinculadas a esta factura.
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="fa-solid fa-file-invoice fa-3x mb-3 d-block"></i>
                    <h5>Seleccione o cree una factura</h5>
                    <p>Use el panel izquierdo para buscar una factura existente o crear una nueva.</p>
                    <p><small>Atajos: <kbd>F2</kbd> Nueva | <kbd>F3</kbd> Editar | <kbd>F5</kbd> Buscar Piezas | <kbd>F6</kbd> Buscar Factura</small></p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function() {
    // ─── Form Factura: Nueva / Editar ───
    var formCard = document.getElementById('formFacturaCard');
    var formFactura = document.getElementById('formFactura');
    var formTitulo = document.getElementById('formFacturaTitulo');
    var btnNueva = document.getElementById('btnNuevaFactura');
    var btnEditar = document.getElementById('btnEditarFactura');
    var btnCancelar = document.getElementById('btnCancelarFactura');

    function mostrarFormNueva() {
        if (!formCard) return;
        formCard.style.display = 'block';
        formTitulo.textContent = 'Nueva Factura';
        formFactura.action = '?handler=CrearFactura';
        document.getElementById('frmIdFactura').value = '';
        document.getElementById('frmFolioFactura').value = '';
        document.getElementById('frmFechaFactura').value = new Date().toISOString().split('T')[0];
        document.getElementById('frmProveedor').value = '';
        document.getElementById('frmRazonSocial').innerHTML = '<option value="">-- Seleccione proveedor primero --</option>';
        document.getElementById('frmPedimento').value = '';
        // Destruir TomSelect si existe, para re-crear
        var selProv = document.getElementById('frmProveedor');
        if (selProv && selProv.tomselect) selProv.tomselect.clear();
        document.getElementById('frmFolioFactura').focus();
    }

    function mostrarFormEditar() {
        @if (tieneFactura)
        {
            <text>
            if (!formCard) return;
            formCard.style.display = 'block';
            formTitulo.textContent = 'Editar Factura #@Model.FacturaActual!.IdFactura';
            formFactura.action = '?handler=EditarFactura';
            document.getElementById('frmIdFactura').value = '@Model.FacturaActual.IdFactura';
            document.getElementById('frmFolioFactura').value = '@Model.FacturaActual.FolioFactura';
            document.getElementById('frmFechaFactura').value = '@Model.FacturaActual.FechaFactura.ToString("yyyy-MM-dd")';
            var selProv = document.getElementById('frmProveedor');
            if (selProv.tomselect) { selProv.tomselect.setValue('@Model.FacturaActual.Proveedor'); }
            else { selProv.value = '@Model.FacturaActual.Proveedor'; }
            document.getElementById('frmPedimento').value = '@(Model.FacturaActual.Pedimento ?? "")';
            cargarRazonesSociales(@Model.FacturaActual.Proveedor, @Model.FacturaActual.IdRazonSocialProveedor);
            </text>
        }
    }

    if (btnNueva) btnNueva.addEventListener('click', mostrarFormNueva);
    if (btnEditar) btnEditar.addEventListener('click', mostrarFormEditar);
    if (btnCancelar) btnCancelar.addEventListener('click', function() {
        formCard.style.display = 'none';
    });

    // ─── Carga dinámica de razones sociales ───
    var selProveedor = document.getElementById('frmProveedor');
    var selRazonSocial = document.getElementById('frmRazonSocial');

    async function cargarRazonesSociales(proveedor, seleccionarId) {
        if (!selRazonSocial) return;
        selRazonSocial.innerHTML = '<option value="">Cargando...</option>';
        try {
            var resp = await fetch('?handler=RazonesSociales&proveedor=' + proveedor);
            var data = await resp.json();
            selRazonSocial.innerHTML = '<option value="">-- Seleccionar --</option>';
            data.forEach(function(rs) {
                var opt = document.createElement('option');
                opt.value = rs.idRazonSocialProveedor;
                opt.textContent = rs.razonSocialProveedor;
                if (seleccionarId && rs.idRazonSocialProveedor == seleccionarId) opt.selected = true;
                selRazonSocial.appendChild(opt);
            });
        } catch (e) {
            selRazonSocial.innerHTML = '<option value="">Error al cargar</option>';
        }
    }

    if (selProveedor) {
        selProveedor.addEventListener('change', function() {
            var val = this.value || (this.tomselect ? this.tomselect.getValue() : '');
            if (val) cargarRazonesSociales(val, null);
            else if (selRazonSocial) selRazonSocial.innerHTML = '<option value="">-- Seleccione proveedor primero --</option>';
        });
    }

    // ─── TomSelect para combos searchable ───
    if (typeof TomSelect !== 'undefined' && selProveedor && !selProveedor.tomselect) {
        new TomSelect(selProveedor, {
            allowEmptyOption: true,
            sortField: { field: 'text', direction: 'asc' }
        });
    }

    // ─── Panel de Costos: selección de pieza ───
    var panelCostos = document.getElementById('panelCostos');
    var costCodigo = document.getElementById('costCodigo');
    var costCodigoLabel = document.getElementById('costCodigoLabel');
    var costObs2Label = document.getElementById('costObs2Label');
    var costCB = document.getElementById('costCB');
    var costCN = document.getElementById('costCN');
    var costTC = document.getElementById('costTC');
    var costBrutoMN = document.getElementById('costBrutoMN');
    var costNetoMN = document.getElementById('costNetoMN');
    var ultimoTC = null; // Recordar último TC usado (VB6: UltimoTipoCambio)

    var descPiezaActual = 0; // Descuento de la pieza seleccionada

    function seleccionarPieza(row) {
        // Deseleccionar otras
        document.querySelectorAll('.pieza-row.selected').forEach(function(r) { r.classList.remove('selected'); });
        row.classList.add('selected');

        var codigo = row.dataset.codigo;
        var obs2 = row.dataset.obs2 || '';
        var cb = parseFloat(row.dataset.cb) || 0;
        var cn = parseFloat(row.dataset.cn) || 0;
        var tc = parseFloat(row.dataset.tc) || 1;
        descPiezaActual = parseFloat(row.dataset.descPieza) || 0;

        // Si hay un TC guardado de la operación anterior, usarlo
        if (ultimoTC !== null && ultimoTC > 0) tc = ultimoTC;

        costCodigo.value = codigo;
        costCodigoLabel.textContent = codigo;
        costObs2Label.textContent = obs2 ? ' — ' + obs2 : '';
        costCB.value = cb.toFixed(2);
        costCN.value = cn.toFixed(2);
        costTC.value = tc.toFixed(4);
        panelCostos.style.display = 'block';
        recalcularMN();
        costCB.focus();
        costCB.select();
    }

    function recalcularMN() {
        if (!costCB || !costCN || !costTC) return;
        var cb = parseFloat(costCB.value) || 0;
        var cn = parseFloat(costCN.value) || 0;
        var tc = parseFloat(costTC.value) || 1;
        if (costBrutoMN) costBrutoMN.textContent = (cb * tc).toFixed(2);
        if (costNetoMN) costNetoMN.textContent = (cn * tc).toFixed(2);
    }

    // Eventos en tabla de disponibles
    var tblDisponibles = document.getElementById('tblDisponibles');
    if (tblDisponibles) {
        tblDisponibles.addEventListener('click', function(e) {
            var row = e.target.closest('.pieza-row');
            if (row) seleccionarPieza(row);
        });
    }

    // Recalcular CN automáticamente al cambiar CB (VB6: txtCN = txtCB * (1 - DescPieza/100))
    if (costCB) costCB.addEventListener('input', function() {
        if (descPiezaActual > 0) {
            var cb = parseFloat(costCB.value) || 0;
            costCN.value = (cb * (1 - descPiezaActual / 100)).toFixed(2);
        }
        recalcularMN();
    });
    if (costCN) costCN.addEventListener('input', recalcularMN);
    if (costTC) costTC.addEventListener('input', recalcularMN);

    // Guardar TC al asignar
    var formAsignar = document.getElementById('formAsignar');
    if (formAsignar) {
        formAsignar.addEventListener('submit', function() {
            ultimoTC = parseFloat(costTC.value) || null;
        });
    }

    // Auto-seleccionar primera pieza al cargar
    if (tblDisponibles) {
        var primeraFila = tblDisponibles.querySelector('.pieza-row');
        if (primeraFila) seleccionarPieza(primeraFila);
    }

    // ─── Atajos de teclado ───
    document.addEventListener('keydown', function(e) {
        if (e.key === 'F2') { e.preventDefault(); mostrarFormNueva(); }
        if (e.key === 'F3' && btnEditar) { e.preventDefault(); mostrarFormEditar(); }
        if (e.key === 'F5') {
            e.preventDefault();
            var input = document.getElementById('txtFiltroPiezas');
            if (input) input.focus();
        }
        if (e.key === 'F6') {
            e.preventDefault();
            var filtro = document.querySelector('input[name="filtroFacturas"]');
            if (filtro) filtro.focus();
        }
        if (e.key === 'Escape' && formCard && formCard.style.display !== 'none') {
            e.preventDefault();
            formCard.style.display = 'none';
        }
        // Enter en panel de costos → submit asignar
        if (e.key === 'Enter' && panelCostos && panelCostos.style.display !== 'none') {
            var activeEl = document.activeElement;
            if (activeEl && (activeEl.id === 'costCB' || activeEl.id === 'costCN' || activeEl.id === 'costTC')) {
                e.preventDefault();
                formAsignar.requestSubmit();
            }
        }
        // Flechas arriba/abajo en tabla disponibles
        if (tblDisponibles && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
            var selected = tblDisponibles.querySelector('.pieza-row.selected');
            if (selected) {
                e.preventDefault();
                var next = e.key === 'ArrowDown' ? selected.nextElementSibling : selected.previousElementSibling;
                if (next && next.classList.contains('pieza-row')) seleccionarPieza(next);
            }
        }
    });
})();
</script>
}
