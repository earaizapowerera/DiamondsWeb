@page
@model DiamondsWeb.Pages.Proveedores.AsignacionesModel
@{
    ViewData["Title"] = "Asignar Razones Sociales a Proveedores";
    var tituloFiltrado = Model.RazonSocialSeleccionada != null
        ? $"Asignaciones de: {Model.RazonSocialSeleccionada.RazonSocialProveedorNombre}"
        : "Todas las Asignaciones";
}

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-check-circle me-2"></i>@Model.MensajeExito
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@Model.MensajeError
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Info de razón social seleccionada -->
@if (Model.RazonSocialSeleccionada != null)
{
<div class="info-panel mb-3">
    <div class="row">
        <div class="col-md-6">
            <h6><i class="fa-solid fa-building me-2"></i>@Model.RazonSocialSeleccionada.RazonSocialProveedorNombre</h6>
            <small class="text-muted">
                RFC: @(string.IsNullOrWhiteSpace(Model.RazonSocialSeleccionada.RFC) ? "N/A" : Model.RazonSocialSeleccionada.RFC)
                @if (!string.IsNullOrWhiteSpace(Model.RazonSocialSeleccionada.Calle))
                {
                    <span>| @Model.RazonSocialSeleccionada.Calle</span>
                    @if (!string.IsNullOrWhiteSpace(Model.RazonSocialSeleccionada.Colonia))
                    {
                        <span>, @Model.RazonSocialSeleccionada.Colonia</span>
                    }
                }
            </small>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Proveedores/RazonesSociales" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>Volver a Razones Sociales
            </a>
        </div>
    </div>
</div>
}

<!-- Filtro -->
<div class="filter-panel mb-3">
    <form method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label"><small>Buscar</small></label>
                <input type="text" class="form-control form-control-sm" name="Buscar"
                       value="@Model.Buscar" placeholder="Proveedor o razón social..." />
            </div>
            @if (Model.IdRazonSocial.HasValue)
            {
                <input type="hidden" name="idRazonSocial" value="@Model.IdRazonSocial" />
            }
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-6 text-end">
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalAsignacion">
                    <i class="fa-solid fa-plus me-1"></i>Nueva Asignación
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Tabla de asignaciones -->
<div class="card">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-link me-2"></i>@tituloFiltrado (@Model.Asignaciones.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px">ID</th>
                        <th>Razón Social</th>
                        <th>Proveedor</th>
                        <th>ID Proveedor</th>
                        <th style="width:100px" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Asignaciones.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                No hay asignaciones
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model.Asignaciones)
                    {
                        <tr>
                            <td>@a.Id</td>
                            <td>
                                <a href="/Proveedores/Asignaciones?idRazonSocial=@a.IdRazonSocialProveedor">
                                    @a.RazonSocialProveedorNombre
                                </a>
                            </td>
                            <td><strong>@a.NombreProveedor</strong></td>
                            <td>@a.Proveedor</td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="Eliminar" class="d-inline">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    @if (Model.IdRazonSocial.HasValue)
                                    {
                                        <input type="hidden" name="idRazonSocial" value="@Model.IdRazonSocial" />
                                    }
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar asignación"
                                            onclick="return confirm('¿Eliminar asignación de @System.Web.HttpUtility.JavaScriptStringEncode(a.NombreProveedor ?? "") con @System.Web.HttpUtility.JavaScriptStringEncode(a.RazonSocialProveedorNombre ?? "")?')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.RazonSocialSeleccionada == null)
{
<div class="mt-3 text-end">
    <a href="/Proveedores/RazonesSociales" class="btn btn-outline-dark btn-sm">
        <i class="fa-solid fa-building me-1"></i>Ir a Razones Sociales
    </a>
</div>
}

<!-- Modal Crear Asignación -->
<div class="modal fade" id="modalAsignacion" tabindex="-1" aria-labelledby="modalAsignacionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Crear">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalAsignacionLabel">
                        <i class="fa-solid fa-link me-2"></i>Nueva Asignación
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (Model.IdRazonSocial.HasValue)
                    {
                        <input type="hidden" name="idRazonSocial" value="@Model.IdRazonSocial" />
                    }
                    <div class="mb-3">
                        <label class="form-label">Razón Social <span class="text-danger">*</span></label>
                        @if (Model.IdRazonSocial.HasValue && Model.RazonSocialSeleccionada != null)
                        {
                            <input type="hidden" name="idRazonSocialForm" value="@Model.IdRazonSocial" />
                            <input type="text" class="form-control" disabled
                                   value="@Model.RazonSocialSeleccionada.RazonSocialProveedorNombre" />
                        }
                        else
                        {
                            <select class="form-select" name="idRazonSocialForm" id="selectRazonSocial" required>
                                <option value="">-- Seleccionar --</option>
                                @foreach (var rs in Model.RazonesSocialesCombo)
                                {
                                    <option value="@rs.IdRazonSocialProveedor">
                                        @rs.RazonSocialProveedorNombre @(string.IsNullOrWhiteSpace(rs.RFC) ? "" : $"({rs.RFC})")
                                    </option>
                                }
                            </select>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Proveedor <span class="text-danger">*</span></label>
                        <select class="form-select" name="proveedorId" id="selectProveedor" required>
                            <option value="">-- Seleccionar --</option>
                            @foreach (var p in Model.ProveedoresCombo)
                            {
                                <option value="@p.Proveedor">@p.NombreProveedor (@p.Proveedor)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-save me-1"></i>Asignar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" />
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
<script>
    // TomSelect para dropdowns con más de 5 opciones
    document.addEventListener('DOMContentLoaded', function () {
        var selRS = document.getElementById('selectRazonSocial');
        if (selRS && typeof TomSelect !== 'undefined') {
            new TomSelect(selRS, {
                allowEmptyOption: true,
                sortField: { field: 'text', direction: 'asc' },
                placeholder: 'Escriba para buscar...'
            });
        }
        var selProv = document.getElementById('selectProveedor');
        if (selProv && typeof TomSelect !== 'undefined') {
            new TomSelect(selProv, {
                allowEmptyOption: true,
                sortField: { field: 'text', direction: 'asc' },
                placeholder: 'Escriba para buscar...'
            });
        }
    });
</script>
}
