@page
@model DiamondsWeb.Pages.AntiLavado.DetalleModel
@{
    ViewData["Title"] = $"Detalle - {Model.ClienteNombre}";
}

<div class="mb-3">
    <a href="/AntiLavado?Mes=@Model.Mes&Anio=@Model.Anio" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Regresar
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4">
                <h4 class="mb-1"><i class="fa-solid fa-user me-2"></i>@Model.ClienteNombre</h4>
                <small class="text-muted">Periodo: @Model.PeriodoDesde.ToString("dd/MM/yyyy") - @Model.PeriodoHasta.ToString("dd/MM/yyyy")</small>
            </div>
            <div class="col-md-4 text-center">
                <div class="fs-3 fw-bold @(Model.NivelAlerta == "AvisoSAT" ? "text-danger" : Model.NivelAlerta == "Identificacion" ? "text-warning" : "text-success")">
                    @Model.TotalAcumulado.ToString("C2")
                </div>
                <small class="text-muted">Total acumulado en @Model.Notas.Count operaciones</small>
            </div>
            <div class="col-md-4 text-end">
                @if (Model.NivelAlerta == "AvisoSAT")
                {
                    <span class="badge badge-aml-aviso fs-6 p-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>REQUIERE AVISO AL SAT</span>
                    <br /><small class="text-muted mt-1 d-block">Supera @Model.Config.UmasAvisoSAT UMAS (@Model.Config.MontoAvisoSAT.ToString("C2"))</small>
                }
                else if (Model.NivelAlerta == "Identificacion")
                {
                    <span class="badge badge-aml-identificacion fs-6 p-2"><i class="fa-solid fa-id-card me-1"></i>REQUIERE IDENTIFICACION</span>
                    <br /><small class="text-muted mt-1 d-block">Supera @Model.Config.UmasIdentificacion UMAS (@Model.Config.MontoIdentificacion.ToString("C2"))</small>
                }
            </div>
        </div>
        <div class="mt-3">
            @{
                var pct = Model.Config.MontoAvisoSAT > 0 ? Math.Min(100, (double)(Model.TotalAcumulado / Model.Config.MontoAvisoSAT * 100)) : 0;
                var pctUmbral = (double)(Model.Config.MontoIdentificacion / Model.Config.MontoAvisoSAT * 100);
            }
            <div class="progress" style="height: 25px;">
                <div class="progress-bar @(Model.NivelAlerta == "AvisoSAT" ? "bg-danger" : Model.NivelAlerta == "Identificacion" ? "bg-warning" : "bg-success")"
                     style="width: @pct.ToString("F1")%">@Model.TotalAcumulado.ToString("C0")</div>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <small class="text-muted">$0</small>
                <small class="text-warning">| @Model.Config.MontoIdentificacion.ToString("C0") (Identif.)</small>
                <small class="text-danger">@Model.Config.MontoAvisoSAT.ToString("C0") (Aviso SAT)</small>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-dark text-white"><i class="fa-solid fa-receipt me-2"></i>Detalle de Operaciones</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-aml table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>No. Nota</th>
                        <th>Cliente</th>
                        <th>RFC</th>
                        <th>Telefono</th>
                        <th class="text-end">Total</th>
                        <th>Fecha</th>
                        <th>Forma de Pago</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Notas.Count; i++)
                    {
                        var nota = Model.Notas[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><strong>@nota.IdNota</strong></td>
                            <td>@nota.NombreCliente</td>
                            <td>@(string.IsNullOrWhiteSpace(nota.RFC) ? "-" : nota.RFC)</td>
                            <td>@(string.IsNullOrWhiteSpace(nota.Telefonos) ? "-" : nota.Telefonos)</td>
                            <td class="text-end fw-bold">@nota.Total.ToString("C2")</td>
                            <td>@nota.FechaBaja.ToString("dd/MM/yyyy")</td>
                            <td>@(nota.FormaPago ?? "-")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold bg-light">
                        <td colspan="5" class="text-end">TOTAL ACUMULADO:</td>
                        <td class="text-end @(Model.NivelAlerta == "AvisoSAT" ? "text-danger" : "text-warning")">@Model.TotalAcumulado.ToString("C2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
