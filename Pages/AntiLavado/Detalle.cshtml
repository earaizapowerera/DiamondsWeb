@page
@model DiamondsWeb.Pages.AntiLavado.DetalleModel
@{
    ViewData["Title"] = $"Detalle - {Model.ClienteNombre}";
}

<div class="mb-3">
    <a href="/AntiLavado?Mes=@Model.Mes&Anio=@Model.Anio" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Regresar
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4">
                <h4 class="mb-1"><i class="fa-solid fa-user me-2"></i>@Model.ClienteNombre</h4>
                <small class="text-muted">Periodo: @Model.PeriodoDesde.ToString("dd/MM/yyyy") - @Model.PeriodoHasta.ToString("dd/MM/yyyy")</small>
            </div>
            <div class="col-md-4 text-center">
                <div class="fs-3 fw-bold @(Model.NivelAlerta == "AvisoSAT" ? "text-danger" : Model.NivelAlerta == "Identificacion" ? "text-warning" : "text-success")">
                    @Model.TotalAcumulado.ToString("C2")
                </div>
                <small class="text-muted">Total acumulado en @Model.Notas.Count operaciones</small>
            </div>
            <div class="col-md-4 text-end">
                @if (Model.NivelAlerta == "AvisoSAT")
                {
                    <span class="badge badge-aml-aviso fs-6 p-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>REQUIERE AVISO AL SAT</span>
                    <br /><small class="text-muted mt-1 d-block">Supera @Model.Config.UmasAvisoSAT UMAS (@Model.Config.MontoAvisoSAT.ToString("C2"))</small>
                }
                else if (Model.NivelAlerta == "Identificacion")
                {
                    <span class="badge badge-aml-identificacion fs-6 p-2"><i class="fa-solid fa-id-card me-1"></i>REQUIERE IDENTIFICACION</span>
                    <br /><small class="text-muted mt-1 d-block">Supera @Model.Config.UmasIdentificacion UMAS (@Model.Config.MontoIdentificacion.ToString("C2"))</small>
                }
            </div>
        </div>
        <div class="mt-3">
            @{
                var pct = Model.Config.MontoAvisoSAT > 0 ? Math.Min(100, (double)(Model.TotalAcumulado / Model.Config.MontoAvisoSAT * 100)) : 0;
                var pctUmbral = (double)(Model.Config.MontoIdentificacion / Model.Config.MontoAvisoSAT * 100);
            }
            <div class="progress" style="height: 25px;">
                <div class="progress-bar @(Model.NivelAlerta == "AvisoSAT" ? "bg-danger" : Model.NivelAlerta == "Identificacion" ? "bg-warning" : "bg-success")"
                     style="width: @pct.ToString("F1")%">@Model.TotalAcumulado.ToString("C0")</div>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <small class="text-muted">$0</small>
                <small class="text-warning">| @Model.Config.MontoIdentificacion.ToString("C0") (Identif.)</small>
                <small class="text-danger">@Model.Config.MontoAvisoSAT.ToString("C0") (Aviso SAT)</small>
            </div>
        </div>
    </div>
</div>

<!-- ==================== IDENTIFICACIONES DEL CLIENTE ==================== -->
<div class="card mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-id-card me-2"></i>Identificaciones del Cliente</span>
        <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSubirId">
            <i class="fa-solid fa-plus me-1"></i>Agregar
        </button>
    </div>

    <!-- Documentos existentes -->
    <div class="card-body">
        @if (Model.Identificaciones.Count == 0)
        {
            <p class="text-muted mb-0"><i class="fa-solid fa-info-circle me-1"></i>No hay identificaciones registradas para este cliente.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var doc in Model.Identificaciones)
                {
                    var isPdf = doc.ContentType?.Contains("pdf") == true;
                    <div class="col-md-4 col-lg-3">
                        <div class="card h-100 border">
                            @if (isPdf)
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 160px;">
                                    <a href="@doc.Url" target="_blank"><i class="fa-solid fa-file-pdf text-danger" style="font-size: 4rem;"></i></a>
                                </div>
                            }
                            else
                            {
                                <a href="@doc.Url" target="_blank">
                                    <img src="@doc.Url" class="card-img-top" style="height: 160px; object-fit: cover;" alt="@doc.TipoDocumento" />
                                </a>
                            }
                            <div class="card-body p-2">
                                <span class="badge bg-primary">@doc.TipoDocumento</span>
                                <small class="d-block text-muted mt-1">@doc.FechaSubida.ToString("dd/MM/yyyy HH:mm")</small>
                                @if (!string.IsNullOrEmpty(doc.Notas))
                                {
                                    <small class="d-block text-muted">@doc.Notas</small>
                                }
                                <small class="d-block text-muted">Por: @doc.SubidoPor</small>
                            </div>
                            <div class="card-footer p-1 text-end">
                                <form method="post" asp-page-handler="DeleteId"
                                      asp-route-mes="@Model.Mes" asp-route-anio="@Model.Anio"
                                      onsubmit="return confirm('Eliminar esta identificacion?')">
                                    <input type="hidden" name="cliente" value="@Model.ClienteNombre" />
                                    <input type="hidden" name="idDoc" value="@doc.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Formulario para agregar identificacion -->
    <div class="collapse" id="collapseSubirId">
        <div class="card-body border-top">
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabUpload" type="button">
                        <i class="fa-solid fa-upload me-1"></i>Subir Archivo
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabMovil" type="button">
                        <i class="fa-solid fa-mobile-screen me-1"></i>Fotos del Movil (@Model.FotosMovilRecientes.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Tab: Subir archivo -->
                <div class="tab-pane fade show active" id="tabUpload">
                    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data"
                          asp-route-mes="@Model.Mes" asp-route-anio="@Model.Anio">
                        <input type="hidden" name="cliente" value="@Model.ClienteNombre" />
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Tipo de Documento</label>
                                <select name="tipoDocumento" class="form-select" required>
                                    <option value="INE">INE / IFE</option>
                                    <option value="Pasaporte">Pasaporte</option>
                                    <option value="CURP">CURP</option>
                                    <option value="RFC">Constancia RFC</option>
                                    <option value="Comprobante">Comprobante Domicilio</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Archivo</label>
                                <input type="file" name="archivo" class="form-control" accept="image/*,.pdf" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Notas (opcional)</label>
                                <input type="text" name="notas" class="form-control" placeholder="Ej: Frente, Reverso..." />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fa-solid fa-upload me-1"></i>Subir
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Tab: Fotos del movil -->
                <div class="tab-pane fade" id="tabMovil">
                    @if (Model.FotosMovilRecientes.Count == 0)
                    {
                        <p class="text-muted">No hay fotos recientes del movil disponibles. Usa la app para tomar fotos primero.</p>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="LinkFoto"
                              asp-route-mes="@Model.Mes" asp-route-anio="@Model.Anio" id="formLinkFoto">
                            <input type="hidden" name="cliente" value="@Model.ClienteNombre" />
                            <input type="hidden" name="fotoId" id="selectedFotoId" value="" />
                            <div class="row g-2 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label">Tipo de Documento</label>
                                    <select name="tipoDocumento" class="form-select" required>
                                        <option value="INE">INE / IFE</option>
                                        <option value="Pasaporte">Pasaporte</option>
                                        <option value="CURP">CURP</option>
                                        <option value="RFC">Constancia RFC</option>
                                        <option value="Comprobante">Comprobante Domicilio</option>
                                        <option value="Otro">Otro</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Notas (opcional)</label>
                                    <input type="text" name="notas" class="form-control" placeholder="Ej: Frente, Reverso..." />
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-success w-100" id="btnLinkFoto" disabled>
                                        <i class="fa-solid fa-link me-1"></i>Vincular Seleccionada
                                    </button>
                                </div>
                            </div>
                        </form>
                        <div class="row g-2">
                            @foreach (var foto in Model.FotosMovilRecientes)
                            {
                                <div class="col-4 col-md-2">
                                    <div class="card foto-movil-card @(foto.IsLinked ? "opacity-50" : "")"
                                         data-foto-id="@foto.Id" style="cursor: pointer;"
                                         onclick="selectFotoMovil(this, @foto.Id)">
                                        <img src="@foto.Url" class="card-img-top" style="height: 100px; object-fit: cover;" />
                                        <div class="card-body p-1 text-center">
                                            <small class="text-muted">@foto.UploadedAt.ToString("dd/MM HH:mm")</small>
                                            @if (foto.IsLinked)
                                            {
                                                <br /><small class="text-warning">Vinculada</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== DETALLE DE OPERACIONES ==================== -->
<div class="card">
    <div class="card-header bg-dark text-white"><i class="fa-solid fa-receipt me-2"></i>Detalle de Operaciones</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-aml table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>No. Nota</th>
                        <th>Cliente</th>
                        <th>RFC</th>
                        <th>Telefono</th>
                        <th class="text-end">Total</th>
                        <th>Fecha</th>
                        <th>Forma de Pago</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Notas.Count; i++)
                    {
                        var nota = Model.Notas[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><strong>@nota.IdNota</strong></td>
                            <td>@nota.NombreCliente</td>
                            <td>@(string.IsNullOrWhiteSpace(nota.RFC) ? "-" : nota.RFC)</td>
                            <td>@(string.IsNullOrWhiteSpace(nota.Telefonos) ? "-" : nota.Telefonos)</td>
                            <td class="text-end fw-bold">@nota.Total.ToString("C2")</td>
                            <td>@nota.FechaBaja.ToString("dd/MM/yyyy")</td>
                            <td>
                                @{
                                    var tieneDesglose = Model.DesglosePageos.TryGetValue(nota.IdNota, out var pagos) && pagos.Count > 1;
                                }
                                @if (tieneDesglose)
                                {
                                    var tooltipLines = string.Join("&#10;", pagos!.Select(p => $"{p.OpcionPago}: {p.Importe.ToString("C2")}"));
                                    <span style="border-bottom: 1px dotted #666; cursor: help;" title="@tooltipLines">
                                        @(nota.FormaPago ?? "-")
                                    </span>
                                }
                                else
                                {
                                    @(nota.FormaPago ?? "-")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold bg-light">
                        <td colspan="5" class="text-end">TOTAL ACUMULADO:</td>
                        <td class="text-end @(Model.NivelAlerta == "AvisoSAT" ? "text-danger" : "text-warning")">@Model.TotalAcumulado.ToString("C2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
function selectFotoMovil(card, fotoId) {
    document.querySelectorAll('.foto-movil-card').forEach(c => c.classList.remove('border-primary', 'border-3'));
    card.classList.add('border-primary', 'border-3');
    document.getElementById('selectedFotoId').value = fotoId;
    document.getElementById('btnLinkFoto').disabled = false;
}
</script>
}
