@page
@model DiamondsWeb.Pages.AntiLavado.HomologacionModel
@{
    ViewData["Title"] = "Homologación de Clientes";
    var totalPages = (int)Math.Ceiling((double)Model.TotalGrupos / Model.PageSize);
}

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-check-circle me-2"></i>@Model.Mensaje
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-exclamation-circle me-2"></i>@Model.Error
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-2 col-sm-4 mb-2">
        <div class="card text-center border-primary">
            <div class="card-body py-2">
                <h4 class="mb-0 text-primary">@Model.Stats.NombresDistintosOriginal.ToString("N0")</h4>
                <small class="text-muted">Nombres distintos</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 mb-2">
        <div class="card text-center border-success">
            <div class="card-body py-2">
                <h4 class="mb-0 text-success">@Model.Stats.NombresDistintosPostHomologacion.ToString("N0")</h4>
                <small class="text-muted">Post-homologación</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 mb-2">
        <div class="card text-center border-warning">
            <div class="card-body py-2">
                <h4 class="mb-0 text-warning">@Model.Stats.GruposPendientes</h4>
                <small class="text-muted">Grupos pendientes</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 mb-2">
        <div class="card text-center border-info">
            <div class="card-body py-2">
                <h4 class="mb-0 text-info">@Model.Stats.GruposAprobados</h4>
                <small class="text-muted">Grupos aprobados</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 mb-2">
        <div class="card text-center">
            <div class="card-body py-2">
                <h4 class="mb-0">@Model.Stats.NombresHomologados</h4>
                <small class="text-muted">Nombres homologados</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-sm-4 mb-2">
        <div class="card text-center">
            <div class="card-body py-2">
                @{
                    int reduccion = Model.Stats.NombresDistintosOriginal - Model.Stats.NombresDistintosPostHomologacion;
                    decimal pct = Model.Stats.NombresDistintosOriginal > 0
                        ? (decimal)reduccion / Model.Stats.NombresDistintosOriginal * 100 : 0;
                }
                <h4 class="mb-0 text-danger">-@reduccion</h4>
                <small class="text-muted">Reducción (@pct.ToString("N1")%)</small>
            </div>
        </div>
    </div>
</div>

<!-- Toolbar -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <form method="post" asp-page-handler="Detectar" class="d-inline">
            <button type="submit" class="btn btn-primary"
                    onclick="this.disabled=true; this.innerHTML='<i class=\'fa-solid fa-spinner fa-spin me-1\'></i>Detectando...'; this.form.submit();">
                <i class="fa-solid fa-magnifying-glass me-1"></i>Detectar duplicados
            </button>
        </form>
        @if (Model.Stats.GruposPendientes > 0)
        {
            <form method="post" asp-page-handler="AprobarTodos" class="d-inline ms-2">
                <input type="hidden" name="umbral" value="0.90" />
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('¿Aprobar todos los grupos con confianza >= 90%?')">
                    <i class="fa-solid fa-check-double me-1"></i>Aprobar todos (>= 90%)
                </button>
            </form>
        }
    </div>
    <div>
        <form method="get" class="d-flex gap-2">
            <input type="hidden" name="Tab" value="@Model.Tab" />
            <input type="text" name="Buscar" class="form-control form-control-sm" style="width:200px"
                   placeholder="Buscar cliente..." value="@Model.Buscar" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-search"></i>
            </button>
        </form>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab != "aprobados" ? "active" : "")"
           href="/AntiLavado/Homologacion?Tab=pendientes&Buscar=@Model.Buscar">
            <i class="fa-solid fa-clock me-1"></i>Pendientes
            @if (Model.Stats.GruposPendientes > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@Model.Stats.GruposPendientes</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "aprobados" ? "active" : "")"
           href="/AntiLavado/Homologacion?Tab=aprobados&Buscar=@Model.Buscar">
            <i class="fa-solid fa-check-circle me-1"></i>Aprobados
            @if (Model.Stats.GruposAprobados > 0)
            {
                <span class="badge bg-success ms-1">@Model.Stats.GruposAprobados</span>
            }
        </a>
    </li>
</ul>

@if (Model.Tab != "aprobados")
{
    <!-- Pendientes -->
    @if (Model.GruposPendientes.Any())
    {
        @foreach (var grupo in Model.GruposPendientes)
        {
            var badgeClass = grupo.MetodoDeteccion switch
            {
                "telefono" => "bg-info",
                "normalizacion" => "bg-success",
                "levenshtein" => "bg-warning text-dark",
                _ => "bg-secondary"
            };
            var confianzaClass = grupo.ConfianzaPromedio >= 0.90m ? "text-success"
                : grupo.ConfianzaPromedio >= 0.75m ? "text-warning" : "text-danger";

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <div>
                        <span class="badge @badgeClass me-2">@grupo.MetodoDeteccion</span>
                        <strong class="@confianzaClass">@grupo.ConfianzaPromedio.ToString("P0")</strong>
                        <span class="text-muted ms-2">Grupo #@grupo.GrupoId</span>
                        <span class="text-muted ms-2">(@grupo.Variantes.Count variantes, @grupo.TotalRegistrosBajasNotas notas)</span>
                    </div>
                    <div class="d-flex gap-1">
                        <form method="post" asp-page-handler="Aprobar" class="d-inline">
                            <input type="hidden" name="grupoId" value="@grupo.GrupoId" />
                            <input type="hidden" name="nombreCanonical" value="" id="canonical-@grupo.GrupoId" />
                            <button type="submit" class="btn btn-success btn-sm"
                                    title="Aprobar grupo">
                                <i class="fa-solid fa-check me-1"></i>Aprobar
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Rechazar" class="d-inline">
                            <input type="hidden" name="grupoId" value="@grupo.GrupoId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('¿Rechazar este grupo?')"
                                    title="Rechazar — no son la misma persona">
                                <i class="fa-solid fa-times"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr class="table-light">
                                <th style="width:40px"></th>
                                <th>Nombre original</th>
                                <th>Nombre canónico</th>
                                <th class="text-center" style="width:80px">Confianza</th>
                                <th class="text-center" style="width:80px">Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in grupo.Variantes)
                            {
                                var isCanonical = v.NombreOriginal == v.NombreCanonical;
                                <tr class="@(isCanonical ? "table-success" : "")">
                                    <td class="text-center">
                                        @if (isCanonical)
                                        {
                                            <i class="fa-solid fa-star text-warning" title="Nombre canónico"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-arrow-right text-muted"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (isCanonical)
                                        {
                                            <strong>@v.NombreOriginal</strong>
                                        }
                                        else
                                        {
                                            @v.NombreOriginal
                                        }
                                    </td>
                                    <td>
                                        @if (!isCanonical)
                                        {
                                            <span class="text-success">→ @v.NombreCanonical</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">(canónico)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(v.Confianza >= 0.90m ? "bg-success" : v.Confianza >= 0.75m ? "bg-warning text-dark" : "bg-danger")">
                                            @v.Confianza.ToString("P0")
                                        </span>
                                    </td>
                                    <td class="text-center">@v.CantidadNotas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Paginación -->
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == Model.Pagina ? "active" : "")">
                            <a class="page-link" href="/AntiLavado/Homologacion?pagina=@p&Tab=@Model.Tab&Buscar=@Model.Buscar">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="fa-solid fa-check-circle fa-3x mb-3 d-block text-success"></i>
                <h5>No hay grupos pendientes de revisión</h5>
                <p>Ejecuta "Detectar duplicados" para encontrar nombres similares que podrían ser la misma persona.</p>
            </div>
        </div>
    }
}
else
{
    <!-- Aprobados -->
    @if (Model.GruposAprobados.Any())
    {
        @foreach (var grupo in Model.GruposAprobados)
        {
            <div class="card mb-2">
                <div class="card-header py-2 bg-light">
                    <i class="fa-solid fa-check-circle text-success me-2"></i>
                    <strong>@grupo.NombreCanonical</strong>
                    <span class="text-muted ms-2">(@grupo.Variantes.Count variantes)</span>
                    <span class="badge bg-secondary ms-2">@grupo.MetodoDeteccion</span>
                </div>
                <div class="card-body py-2">
                    @foreach (var v in grupo.Variantes.Where(v => v.NombreOriginal != v.NombreCanonical))
                    {
                        <span class="badge bg-light text-dark border me-1 mb-1">
                            @v.NombreOriginal <i class="fa-solid fa-arrow-right text-muted mx-1"></i> @v.NombreCanonical
                        </span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="fa-solid fa-inbox fa-3x mb-3 d-block"></i>
                <h5>No hay grupos aprobados aún</h5>
            </div>
        </div>
    }
}

<!-- Link de regreso -->
<div class="mt-3">
    <a href="/AntiLavado" class="btn btn-outline-dark btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Regresar a Control Anti-Lavado
    </a>
</div>
